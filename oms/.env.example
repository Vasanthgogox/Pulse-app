# Pulse Commerce (OMS)
# Dev: root `.env` is loaded automatically (EXPO_PUBLIC_SUPABASE_* or VITE_*).
# Production build: set these in CI/Netlify or copy from root .env before `npm run build`.

# Execution API — Commerce sends POST /execution-plans via Gateway only.
VITE_EXECUTION_API_URL=http://localhost:4000

# Identity DB — same project as Pulse Core (required for suite sign-in)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
