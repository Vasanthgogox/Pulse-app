# Commerce must NEVER write to the Execution database.
VITE_EXECUTION_API_URL=http://localhost:4000

# Identity DB (future Pulse Identity service) — NOT for Execution writes
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
