# Netlify headers (copied to dist root by `expo export --platform web`).
# index.html must stay fresh so clients load the current hashed entry/chunks.

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
