{
  "expo": {
    "name": "q-mobile",
    "slug": "q-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.qmobile.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationWhenInUseUsageDescription": "Driver location is used for live trip tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Location tracking continues during trips even when the app is in background.",
        "NSLocationAlwaysUsageDescription": "This app tracks driver location for logistics trip monitoring."
      }
    },
    "android": {
      "package": "com.qmobile.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow q-mobile to access your photos for profile and uploads.",
          "cameraPermission": "Allow q-mobile to use the camera for profile photos."
        }
      ],
      "expo-detox-config-plugin"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
