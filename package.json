{
  "name": "q-mobile",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "clean:metro": "node scripts/kill-metro-ports.js && node scripts/clear-metro-cache.js",
    "clean:all": "bash scripts/clean-all.sh",
    "clean:all:modules": "bash scripts/clean-all.sh --modules",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 METRO_MAX_WORKERS=8 CI=false npm run web",
    "dev:clean": "npm run clean:metro && npm run web:clean",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=8192 METRO_MAX_WORKERS=8 DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start --go",
    "start:clean": "npm run clean:metro && cross-env NODE_OPTIONS=--max-old-space-size=8192 METRO_MAX_WORKERS=8 DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start --go -c",
    "start:dev-client": "cross-env NODE_OPTIONS=--max-old-space-size=8192 METRO_MAX_WORKERS=8 DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start",
    "start:simulator": "cross-env NODE_OPTIONS=--max-old-space-size=8192 METRO_MAX_WORKERS=8 DOTENV_CONFIG_QUIET=true REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 node -r dotenv/config node_modules/expo/bin/cli start --localhost",
    "start:go": "cross-env NODE_OPTIONS=--max-old-space-size=8192 METRO_MAX_WORKERS=8 DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start --go",
    "preview": "cross-env NODE_OPTIONS=--max-old-space-size=8192 DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start --go --tunnel",
    "start:tunnel": "cross-env NODE_OPTIONS=--max-old-space-size=8192 DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "cross-env DOTENV_CONFIG_QUIET=true DOTENV_CONFIG_OVERRIDE=true NODE_OPTIONS=--max-old-space-size=8192 METRO_MAX_WORKERS=8 node -r dotenv/config node_modules/expo/bin/cli start --web",
    "web:clean": "npm run clean:metro && cross-env DOTENV_CONFIG_QUIET=true DOTENV_CONFIG_OVERRIDE=true NODE_OPTIONS=--max-old-space-size=8192 METRO_MAX_WORKERS=8 node -r dotenv/config node_modules/expo/bin/cli start --web -c",
    "bundle:analyze": "cross-env EXPO_ATLAS=true NODE_OPTIONS=--max-old-space-size=8192 npx expo export --platform web",
    "bundle:analyze:open": "npx expo-atlas",
    "build": "npm run build:web",
    "build:web": "expo export --platform web && node scripts/compress-dist.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "test:e2e": "detox test -c ios.sim.debug",
    "test:e2e:build": "detox build -c ios.sim.debug",
    "test:web": "playwright test",
    "test:web:ui": "playwright test --ui",
    "test:web:headed": "playwright test --headed",
    "test:web:report": "playwright show-report",
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/seed-test-data.ts",
    "build:audit": "node scripts/netlify-build-audit.js",
    "build:audit:report": "node scripts/netlify-build-audit.js --output=netlify-build-report",
    "build:graph": "node scripts/find-startup-graph-offenders.mjs",
    "build:graph:strict": "node scripts/find-startup-graph-offenders.mjs --strict",
    "build:barrels": "node scripts/find-barrel-importers.mjs",
    "assets:optimize": "node scripts/optimize-assets.js",
    "db:audit": "bash scripts/sql/audit/run-linked.sh",
    "db:push": "supabase db push",
    "db:push-both": "bash scripts/push-both-dbs.sh",
    "functions:deploy": "supabase functions deploy",
    "functions:deploy-both": "bash scripts/push-both-dbs.sh"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@google/genai": "^1.43.0",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "^1.8.3",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/query-async-storage-persister": "^5.100.9",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.100.9",
    "dotenv": "^17.3.1",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-screen-capture": "~8.0.9",
    "expo-secure-store": "~15.0.3",
    "expo-sharing": "~14.0.8",
    "expo-sms": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "html2canvas": "^1.4.1",
    "jest-expo": "^55.0.16",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet-routing-machine": "^3.2.12",
    "lucide-react-native": "^0.577.0",
    "maplibre-gl": "^5.23.0",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.5.1",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@playwright/test": "^1.48.0",
    "@types/jest": "^29.5.12",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "cross-env": "^7.0.3",
    "detox": "^20.28.0",
    "eslint": "^9.39.3",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "expo-detox-config-plugin": "^12.0.0",
    "expo-dev-client": "~6.0.3",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.34.5",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
