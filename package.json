{
  "name": "q-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "cross-env CI=false npm run web",
    "start": "cross-env DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start --go",
    "start:dev-client": "cross-env DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start",
    "start:simulator": "cross-env DOTENV_CONFIG_QUIET=true REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 node -r dotenv/config node_modules/expo/bin/cli start --localhost",
    "start:go": "cross-env DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start --go",
    "preview": "cross-env DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start --go --tunnel",
    "start:tunnel": "cross-env DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "cross-env DOTENV_CONFIG_QUIET=true node -r dotenv/config node_modules/expo/bin/cli start --web",
    "build": "npm run build:web",
    "build:web": "npx expo export --platform web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "test:e2e": "detox test -c ios.sim.debug",
    "test:e2e:build": "detox build -c ios.sim.debug",
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/seed-test-data.ts",
    "db:push": "supabase db push",
    "db:push-both": "bash scripts/push-both-dbs.sh",
    "functions:deploy": "supabase functions deploy",
    "functions:deploy-both": "bash scripts/push-both-dbs.sh"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@google/genai": "^1.43.0",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.90.21",
    "dotenv": "^17.3.1",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-screen-capture": "~8.0.9",
    "expo-secure-store": "~15.0.3",
    "expo-sharing": "~14.0.8",
    "expo-sms": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react-native": "^0.577.0",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/jest": "^29.5.12",
    "@types/leaflet": "^1.9.21",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "cross-env": "^7.0.3",
    "detox": "^20.28.0",
    "eslint": "^9.39.3",
    "eslint-plugin-import": "^2.32.0",
    "expo-detox-config-plugin": "^12.0.0",
    "expo-dev-client": "~6.0.3",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
