# Same Supabase project as Q-unified-base. Copy to .env or .env.local and fill values.
# Expo needs EXPO_PUBLIC_* so the app bundle gets them (VITE_* optional, for app.config.js).
# After changing this file, restart the dev server: npx expo start
#
# IMPORTANT: Do not commit real keys. Use placeholders below; get real values from Supabase Dashboard.



# --- Remote (hosted) Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Local Supabase (see docs/LOCAL_SUPABASE.md) ---
# Start local backend: npx supabase start   (API is on port 54321, not 3000)
# Run `npx supabase status` and copy from the tables:
#   APIs → Project URL    → EXPO_PUBLIC_SUPABASE_URL
#   Auth  → Publishable    → EXPO_PUBLIC_SUPABASE_ANON_KEY
#   Auth  → Secret         → SUPABASE_SERVICE_ROLE_KEY (only for npm run seed; do not use in app)
# For iOS Simulator (same machine as Mac): use 127.0.0.1.
# On a physical device, use your machine's IP (e.g. http://192.168.1.x:54321), not localhost.
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# For physical device or Android emulator, use your Mac's IP (e.g. ipconfig getifaddr en0):
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.42:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: same as above, for sharing .env with Q-unified-base
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Web app base (for shared links, e.g. indent bid links) ---
# When set, WhatsApp/share links will use this HTTPS base instead of Expo dev URLs:
#   e.g. EXPO_PUBLIC_WEB_BASE_URL=https://app.your-domain.com
# If left blank, the app will fall back to an internal deep link during development.
# EXPO_PUBLIC_WEB_BASE_URL=https://app.your-domain.com

# --- Trip OTP (aggregate trip claim) ---
# Optional: OTP TTL in minutes (default 15); max failed attempts before "ask for new OTP" (default 5).
# EXPO_PUBLIC_TRIP_OTP_TTL_MINUTES=15
# EXPO_PUBLIC_TRIP_OTP_MAX_ATTEMPTS=5

# --- Ops Agent (Gemini) ---
# Production: deploy supabase/functions/ops-agent-chat and set GEMINI_API_KEY in Supabase secrets.
# App uses proxy (same project URL + /functions/v1/ops-agent-chat) when session exists; no key in client.
# Dev: optional client-side key (do not commit). Override proxy URL if needed:
# EXPO_PUBLIC_OPS_AGENT_PROXY_URL=https://your-project.supabase.co/functions/v1/ops-agent-chat
# EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# --- Place search (pickup/drop) ---
# Primary: Mapbox (recommended, 100k free/mo, fast). Fallback: Nominatim (no key), then cache + popular list.
# EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token
# Optional: Google Places (if set, used when Mapbox returns no results).
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Optional: debug logging for place search (dev only). Set to 1 to see provider hits in console.
# EXPO_PUBLIC_PLACES_DEBUG=1

# --- Google Maps (Android only; required for release map tiles) ---
# Get key from Google Cloud Console (Maps SDK for Android). Restrict by package + SHA-1.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=your-android-maps-api-key
