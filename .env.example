# Same Supabase project as pulse-unified-base. Copy to .env or .env.local and fill values.
# Expo needs EXPO_PUBLIC_* so the app bundle gets them (VITE_* optional, for app.config.js).
# After changing this file, restart the dev server: npx expo start
#
# IMPORTANT: Do not commit real keys. Use placeholders below; get real values from Supabase Dashboard.



# --- Remote (hosted) Supabase ---
# The JS SDK (this app) always connects via HTTPS REST API on port 443.
# Do NOT use the Supavisor Transaction Mode URL (port 6543) here — that is for
# direct Postgres wire protocol tools (psql, pgAdmin, db migrations, Edge Functions
# using pg node driver). The JS SDK never opens a raw pg connection.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supavisor Connection Pooler (for non-SDK direct Postgres connections only):
#   Transaction Mode (psql, short-lived scripts): postgres://postgres.[ref]:password@aws-0-[region].pooler.supabase.com:6543/postgres
#   Session Mode    (migrations, long queries):   postgres://postgres.[ref]:password@aws-0-[region].pooler.supabase.com:5432/postgres
# Get both strings from: Supabase Dashboard → Settings → Database → Connection string → URI
# SUPABASE_DB_POOLER_URL=postgres://postgres.[ref]:password@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Local Supabase (see docs/LOCAL_SUPABASE.md) ---
# Start local backend: npx supabase start   (API is on port 54321, not 3000)
# Run `npx supabase status` and copy from the tables:
#   APIs → Project URL    → EXPO_PUBLIC_SUPABASE_URL
#   Auth  → Publishable    → EXPO_PUBLIC_SUPABASE_ANON_KEY
#   Auth  → Secret         → SUPABASE_SERVICE_ROLE_KEY (only for npm run seed; do not use in app)
# For iOS Simulator (same machine as Mac): use 127.0.0.1.
# On a physical device, use your machine's IP (e.g. http://192.168.1.x:54321), not localhost.
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# For physical device or Android emulator, use your Mac's IP (e.g. ipconfig getifaddr en0):
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.42:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: same as above, for sharing .env with pulse-unified-base
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
#
# Admin console (analytics/ on :3002 → /ops-9f3a2c/) reads root .env via vite.config:
#   EXPO_PUBLIC_SUPABASE_URL  → VITE_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY → VITE_SUPABASE_SERVICE_ROLE_KEY
# Get service_role from Supabase Dashboard → Project Settings → API (secret).
# SUPABASE_SERVICE_ROLE_KEY=
# Optional gate token for the ops console hash login (#token=…)
# VITE_ADMIN_TOKEN=

# --- Web app base (for shared links, e.g. indent bid links) ---
# When set, WhatsApp/share links will use this HTTPS base instead of Expo dev URLs:
#   e.g. EXPO_PUBLIC_WEB_BASE_URL=https://app.your-domain.com
# If left blank, the app will fall back to an internal deep link during development.
# EXPO_PUBLIC_WEB_BASE_URL=https://app.your-domain.com

# --- Sqids opaque IDs (must match app_config.sqids_alphabet in Postgres) ---
# Shuffled a-z0-9 string; used by lib/sqids.ts and DB booking_ref triggers.
# SQIDS_ALPHABET=h4n0kxr7m2qj5w9v3p6f1tz8cbdysgauileo

# --- Trip OTP (aggregate trip claim) ---
# Optional: OTP TTL in minutes (default 15); max failed attempts before "ask for new OTP" (default 5).
# EXPO_PUBLIC_TRIP_OTP_TTL_MINUTES=15
# EXPO_PUBLIC_TRIP_OTP_MAX_ATTEMPTS=5

# --- POD OCR / document chat (Gemini) ---
# Use EXPO_PUBLIC_ prefix so Expo inlines at build time. VITE_GEMINI_API_KEY also works via app.config extra.
# EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# --- Place search (pickup/drop) ---
# Primary: Mapbox (recommended, 100k free/mo, fast). Fallback: Nominatim (no key), then cache + popular list.
# EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token
# Reverse geocode for tracking checkpoints / map labels (required for best results).
# Live GPS movement uses Supabase Broadcast when enabled (no postgres_changes fanout):
# EXPO_PUBLIC_TRACKING_BROADCAST_V1=1
# Optional: Google Places (if set, used when Mapbox returns no results).
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Optional: debug logging for place search (dev only). Set to 1 to see provider hits in console.
# EXPO_PUBLIC_PLACES_DEBUG=1

# --- Web routing (driver map / trip polyline) ---
# On Netlify deploys the app uses /.netlify/functions/route-proxy automatically.
# For Expo web on localhost, set this to your deployed function URL if you need the proxy (CORS):
# EXPO_PUBLIC_ROUTE_PROXY_URL=https://your-app.netlify.app/.netlify/functions/route-proxy

# --- Google Maps (Android only; required for release map tiles) ---
# Get key from Google Cloud Console (Maps SDK for Android). Restrict by package + SHA-1.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=your-android-maps-api-key
