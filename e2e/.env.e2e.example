# Copy to e2e/.env.e2e (gitignored) and fill in a DEDICATED QA account.
# Never put a real user's or a production password here.
#
# Loaded by:
#   - playwright.config.ts        (the e2e/ suite)
#   - nihas-tests/credentials.mjs (the manual smoke scripts)
#
# NOTE: deliberately not named .env*.local at the repo root — Expo's Metro bundler
# treats those as source files and fails the whole web bundle on the first `#` comment.

E2E_EMAIL=qa-user@example.com
E2E_PASSWORD=change-me

# Required by e2e/rbac/member-permissions.spec.ts. Use a THROWAWAY QA member:
# the toggle spec clicks real permission checkboxes on this member (it cancels
# without saving, but point it at someone disposable regardless).
E2E_MEMBER_ID=
