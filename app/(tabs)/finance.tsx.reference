/** FAB with inner ring, press scale, and animated icon (icon pops on press). */
function FabButton({
  icon,
  iconSize,
  style,
  innerRingStyle,
  accentColor,
  onPress,
  accessibilityLabel,
  testID,
}: {
  icon: React.ComponentProps<typeof FontAwesome>["name"];
  iconSize: number;
  style: object;
  innerRingStyle: object;
  accentColor: string;
  onPress: () => void;
  accessibilityLabel: string;
  testID?: string;
}) {
  const buttonScale = useSharedValue(1);
  const iconScale = useSharedValue(1);
  const buttonAnimatedStyle = useAnimatedStyle(() => ({
    transform: [{ scale: buttonScale.value }],
  }));
  const iconAnimatedStyle = useAnimatedStyle(() => ({
    transform: [{ scale: iconScale.value }],
  }));
  return (
    <TouchableOpacity
      testID={testID}
      onPress={onPress}
      onPressIn={() => {
        buttonScale.value = withSpring(0.95, { damping: 18, stiffness: 320 });
        iconScale.value = withSpring(1.2, { damping: 12, stiffness: 400 });
      }}
      onPressOut={() => {
        buttonScale.value = withSpring(1, { damping: 18, stiffness: 320 });
        iconScale.value = withSpring(1, { damping: 14, stiffness: 380 });
      }}
      activeOpacity={1}
      accessibilityLabel={accessibilityLabel}
      style={style}
    >
      <Animated.View style={[styles.fabContentWrap, buttonAnimatedStyle]}>
        <View style={styles.fabHighlightEdge} />
        <View style={styles.fabHighlightEdgeLeft} />
        <View style={innerRingStyle} />
        <Animated.View style={[styles.fabIconWrap, iconAnimatedStyle]}>
          <FontAwesome name={icon} size={iconSize} color={Theme.fabText} />
        </Animated.View>
      </Animated.View>
    </TouchableOpacity>
  );
}

export type FinanceSubTab =
  | "ledger"
  | "customers"
  | "suppliers"
  | "garage"
  | "drivers";

const TABS: { id: FinanceSubTab; label: string }[] = [
  { id: "ledger", label: "LEDGER" },
  { id: "customers", label: "CUSTOMERS" },
  { id: "suppliers", label: "SUPPLIERS" },
  { id: "garage", label: "GARAGE" },
  { id: "drivers", label: "DRIVERS" },
];

/** Min width per tab; when 5 * this > screen width, tab row becomes horizontally scrollable. */
const MIN_FISCAL_TAB_WIDTH = 56;

const SUMMARY_LABELS: Record<FinanceSubTab, { in: string; out: string }> = {
  ledger: { in: "Total Cash In", out: "Total Cash Out" },
  customers: { in: "Total Billing", out: "Total Balance" },
  suppliers: { in: "Total Payables", out: "Unsettled Due" },
  garage: { in: "Asset Revenue", out: "Net Profit" },
  drivers: { in: "Payroll Vol", out: "Salary Due" },
};

const ADD_NODE_LABELS: Record<Exclude<FinanceSubTab, "ledger">, string> = {
  customers: "Add client",
  suppliers: "Add supplier",
  garage: "Add vehicle",
  drivers: "Add driver",
};

/** Last column header for entity tabs: TO COLLECT | TO PAY | PROFIT | DUE */
const LAST_COL_LABEL: Record<FinanceSubTab, string> = {
  customers: "TO COLLECT",
  suppliers: "TO PAY",
  garage: "PROFIT",
  drivers: "DUE",
  ledger: "DUE",
};

const LEDGER_CATEGORY_STORAGE_KEY = "finance_ledger_entity_category";
type LedgerCategory = "all" | "customers" | "suppliers" | "vehicle" | "driver";
const LEDGER_CATEGORIES: LedgerCategory[] = [
  "all",
  "customers",
  "suppliers",
  "vehicle",
  "driver",
];

function filterLedgerByPeriod(
  rows: LedgerRow[],
  period: FinancePeriodFilter,
): LedgerRow[] {
  const today = new Date().toISOString().slice(0, 10);
  const now = new Date();
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1)
    .toISOString()
    .slice(0, 10);
  const endOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0)
    .toISOString()
    .slice(0, 10);
  return rows.filter((r) => {
    const d = (r.transaction_date || r.created_at || "").slice(0, 10);
    if (period === "TODAY") return d === today;
    if (period === "MONTH") return d >= startOfMonth && d <= endOfMonth;
    return true;
  });
}

export default function FinanceScreen() {
  const insets = useSafeAreaInsets();
  const { width: screenWidth } = useWindowDimensions();
  const router = useRouter();
  const { profile } = useAuth();
  const capabilities = getCapabilitiesFromProfile(
    profile
      ? {
          role: profile.role,
          aggregated: profile.aggregated,
          asset: profile.asset,
        }
      : null,
  );
  const canAccess = canAccessFinance(capabilities);
  const { currentOrganization, refreshOrganization } = useOrganization();
  const [financeSubTab, setFinanceSubTab] = useState<FinanceSubTab>("ledger");
  const [financePeriodFilter, setFinancePeriodFilter] =
    useState<FinancePeriodFilter>("RANGE");
  const [showTransactionModal, setShowTransactionModal] = useState(false);
  const [showAddClientModal, setShowAddClientModal] = useState(false);
  const [showAddVehicleModal, setShowAddVehicleModal] = useState(false);
  const [showAddDriverModal, setShowAddDriverModal] = useState(false);
  const [showAddSupplierModal, setShowAddSupplierModal] = useState(false);
  const [editingEntry, setEditingEntry] = useState<LedgerRow | null>(null);
  const [ledgerRefreshKey, setLedgerRefreshKey] = useState(0);
  const [ledgerTransactions, setLedgerTransactions] = useState<
    LedgerRow[] | null
  >(null);
  const [ledgerLoading, setLedgerLoading] = useState(false);
  const [refreshing, setRefreshing] = useState(false);
  const [tabTotals, setTabTotals] = useState({ totalIn: 0, totalOut: 0 });
  const ledgerRefreshKeyRef = useRef(0);
  const [clients, setClients] = useState<PartyOption[]>([]);
  const [clientRows, setClientRows] = useState<ClientRow[]>([]);
  const [trips, setTrips] = useState<TripOption[]>([]);
  const [tripRows, setTripRows] = useState<TripRow[]>([]);
  /** Trips where current org is the client (via clients.linked_organization_id); used for supplier Compare & Verify. */
  const [tripsWhereOrgIsClient, setTripsWhereOrgIsClient] = useState<TripRow[]>(
    [],
  );
  const [supplierRows, setSupplierRows] = useState<SupplierRow[]>([]);
  const [vehicleRows, setVehicleRows] = useState<VehicleRow[]>([]);
  const [driverRows, setDriverRows] = useState<DriverRow[]>([]);
  const [driverOffers, setDriverOffers] = useState<Record<string, DriverOffer>>(
    {},
  );
  const [connectionRequestsSent, setConnectionRequestsSent] = useState<
    ConnectionRequestRow[]
  >([]);
  const [pendingDriverSalaryRequests, setPendingDriverSalaryRequests] =
    useState<SalaryRequestWithDriverRow[]>([]);
  const [entitiesLoading, setEntitiesLoading] = useState(true);
  const [entitiesRefreshKey, setEntitiesRefreshKey] = useState(0);
  const [searchQuery, setSearchQuery] = useState("");
  const [entityFilter, setEntityFilter] = useState<EntityListFilter>("all");
  const [sourceSupplyFilter, setSourceSupplyFilter] = useState<
    "all" | "asset" | "aggregate"
  >("all");
  const [ledgerSortKey, setLedgerSortKey] = useState<
    "entity" | "source" | "cash_in" | "cash_out" | "date"
  >("date");
  const [ledgerSortDir, setLedgerSortDir] = useState<"asc" | "desc">("desc");
  /** Ledger filter: by category (all | customers | suppliers | vehicle | driver). Persisted so it survives tab switch and app restart. */
  const [selectedLedgerCategory, setSelectedLedgerCategory] =
    useState<LedgerCategory>("all");
  /** Ledger filter: by cash direction (all | in | out). Clicking Total Cash In/Out toggles. */
  const [cashDirectionFilter, setCashDirectionFilter] = useState<
    "all" | "in" | "out"
  >("all");
  const [showEntityListModal, setShowEntityListModal] = useState(false);
  const [showReportModal, setShowReportModal] = useState(false);
  const [showSharedLedgerModal, setShowSharedLedgerModal] = useState(false);
  const [suppliersList, setSuppliersList] = useState<
    { id: string; name: string }[]
  >([]);
  const [selectedEntity, setSelectedEntity] = useState<{
    data: FinancialRowData;
    entityType: "CLIENT" | "SUPPLIER" | "VEHICLE" | "DRIVER";
    subTab: FinanceSubTab;
  } | null>(null);
  /** Driver ledger entries for the currently selected driver (monthly statement). */
  const [selectedDriverLedgerEntries, setSelectedDriverLedgerEntries] =
    useState<DriverLedgerRow[] | null>(null);
  const [fabVisible, setFabVisible] = useState(true);
  const fabOpacity = useSharedValue(1);
  const [garagePeriod, setGaragePeriod] = useState<GarragePeriodValue>(() => {
    const d = new Date();
    return `${d.getFullYear()}-${(d.getMonth() + 1).toString().padStart(2, "0")}`;
  });
  /** Trip P&L sheet opened from Garrage TRIPS tab (not from vehicle overlay). */
  const [garageTripIdForPnL, setGarageTripIdForPnL] = useState<string | null>(
    null,
  );
  /** When paying a driver salary request, set before opening transaction modal; cleared in doSubmit after success. */
  const salaryRequestIdToPayAfterSubmitRef = useRef<string | null>(null);
  /** When opening transaction modal from driver salary request (Pay / Pay Now), pre-select this payment type; cleared on modal close. */
  const [defaultDriverPaymentTypeForModal, setDefaultDriverPaymentTypeForModal] =
    useState<DriverPaymentType | null>(null);
  /** When paying a trip_based driver request, pre-select trip and lock it; cleared on modal close. */
  const [payDriverRequestTripPrefill, setPayDriverRequestTripPrefill] = useState<{
    defaultTripId: string;
    tripLocked: boolean;
  } | null>(null);
  /** When opening Add Transaction from trip statement (Record cash in / Record payment / Add expense). */
  const [addEntryContext, setAddEntryContext] =
    useState<TripEntryContext | null>(null);
  /** Inner tabs when Garrage sub-tab is selected (Vehicle | Trips | Revenue | Profit). */
  const [garageViewTab, setGarageViewTab] =
    useState<GarrageViewTab>("vehicle");
  const scrollEndTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(
    null,
  );

  useEffect(() => {
    fabOpacity.value = fabVisible
      ? withTiming(1, { duration: 220 })
      : withTiming(0, { duration: 180 });
  }, [fabVisible]);

  const onScrollBeginDrag = useCallback(() => {
    if (scrollEndTimeoutRef.current) {
      clearTimeout(scrollEndTimeoutRef.current);
      scrollEndTimeoutRef.current = null;
    }
    setFabVisible(false);
  }, []);

  // Clear pull-to-refresh spinner when ledger finish loading
  useEffect(() => {
    if (!ledgerLoading) setRefreshing(false);
  }, [ledgerLoading]);

  // Restore persisted ledger entity filter (category) on mount so tap-on-entity filter persists
  useEffect(() => {
    AsyncStorage.getItem(LEDGER_CATEGORY_STORAGE_KEY).then((saved) => {
      if (
        saved != null &&
        (LEDGER_CATEGORIES as readonly string[]).includes(saved)
      ) {
        setSelectedLedgerCategory(saved as LedgerCategory);
      }
    });
  }, []);

  // Persist ledger category when user changes it so it survives tab switch and app restart
  useEffect(() => {
    AsyncStorage.setItem(LEDGER_CATEGORY_STORAGE_KEY, selectedLedgerCategory);
  }, [selectedLedgerCategory]);

  const onScrollEnd = useCallback(() => {
    if (scrollEndTimeoutRef.current) clearTimeout(scrollEndTimeoutRef.current);
    scrollEndTimeoutRef.current = setTimeout(() => setFabVisible(true), 320);
  }, []);

  const fabContainerAnimatedStyle = useAnimatedStyle(() => ({
    opacity: fabOpacity.value,
    transform: [{ translateY: (1 - fabOpacity.value) * 28 }],
  }));

  useEffect(() => {
    if (!canAccess || !currentOrganization?.id) return;
    Promise.all([
      getClientsByOrganization(currentOrganization.id),
      getTripsByOrganization(currentOrganization.id),
      getSuppliersByOrganization(currentOrganization.id),
    ]).then(([clientRes, tripsRes, supplierRes]) => {
      if (!clientRes.error && clientRes.clients.length) {
        setClients(
          clientRes.clients.map((c) => ({
            id: c.id,
            name: c.name || c.contact_person || "",
          })),
        );
      }
      if (!tripsRes.error && tripsRes.trips.length) {
        setTrips(
          tripsRes.trips.map((t) => ({
            id: t.id,
            trip_number: getTripDisplayNumber(t),
            client_id: t.client_id ?? null,
            client_name: t.client_name ?? null,
            supplier_id: t.supplier_id ?? null,
            driver_id: t.driver_id ?? null,
            vehicle_id: t.vehicle_id ?? null,
            indent_id: t.indent_id ?? null,
            route_label:
              [t.pickup_area, t.drop_location].filter(Boolean).join(" → ") ||
              null,
            trip_date: formatLedgerDate(t.pickup_date || t.created_at),
          })),
        );
      }
      if (!supplierRes.error && supplierRes.suppliers.length) {
        setSuppliersList(
          supplierRes.suppliers.map((s) => ({
            id: s.id,
            name:
              s.company_name ||
              (s as { name?: string }).name ||
              s.contact_person ||
              "",
          })),
        );
      }
    });
  }, [canAccess, currentOrganization?.id]);

  // Refresh entity data when user switches to a sub-tab (tap or swipe) so the visible tab shows fresh data
  useEffect(() => {
    if (canAccess && currentOrganization?.id && financeSubTab !== "ledger") {
      setEntitiesRefreshKey((k) => k + 1);
    }
  }, [canAccess, currentOrganization?.id, financeSubTab]);

  useEffect(() => {
    if (!canAccess || !currentOrganization?.id) {
      setEntitiesLoading(false);
      return;
    }
    const orgId = currentOrganization.id;
    setEntitiesLoading(true);
    Promise.all([
      getClientsByOrganization(orgId),
      getTripsByOrganization(orgId),
      getSuppliersByOrganization(orgId),
      getVehiclesByOrganization(orgId),
      getDriversByOrganization(orgId),
      getDriverOffersByOrganization(orgId),
      getConnectionRequestsSent(orgId),
      getTripsWhereOrgIsClient(orgId),
      getSalaryRequestsByOrganization(orgId, "pending"),
    ]).then(
      ([
        clientRes,
        tripsRes,
        supRes,
        vRes,
        dRes,
        offersRes,
        connSentRes,
        tripsAsClientRes,
        salaryRequestsRes,
      ]) => {
        setEntitiesLoading(false);
        if (!clientRes.error) {
          const list = clientRes.clients;
          setClientRows(list);
          setClients(
            list.map((c) => ({
              id: c.id,
              name: c.name || c.contact_person || "",
            })),
          );
        }
        if (!tripsRes.error) {
          const list = tripsRes.trips ?? [];
          setTripRows(list);
          setTrips(
            list.map((t) => ({
              id: t.id,
              trip_number: getTripDisplayNumber(t),
              client_id: t.client_id ?? null,
              client_name: t.client_name ?? null,
              supplier_id: t.supplier_id ?? null,
              driver_id: t.driver_id ?? null,
              vehicle_id: t.vehicle_id ?? null,
              indent_id: t.indent_id ?? null,
              route_label:
                [t.pickup_area, t.drop_location].filter(Boolean).join(" → ") ||
                null,
              trip_date: formatLedgerDate(t.pickup_date || t.created_at),
            })),
          );
        }
        if (!tripsAsClientRes.error)
          setTripsWhereOrgIsClient(tripsAsClientRes.trips ?? []);
        if (!supRes.error) {
          setSupplierRows(supRes.suppliers);
          if (supRes.suppliers.length) {
            setSuppliersList(
              supRes.suppliers.map((s) => ({
                id: s.id,
                name:
                  s.company_name ||
                  (s as { name?: string }).name ||
                  s.contact_person ||
                  "",
              })),
            );
          }
        }
        if (!vRes.error) setVehicleRows(vRes.vehicles);
        if (!dRes.error) setDriverRows(dRes.drivers);
        if (!offersRes.error) setDriverOffers(offersRes.offersByDriverId ?? {});
        if (!connSentRes.error)
          setConnectionRequestsSent(connSentRes.requests ?? []);
        if (!salaryRequestsRes.error)
          setPendingDriverSalaryRequests(salaryRequestsRes.requests ?? []);
      },
    );
  }, [canAccess, currentOrganization?.id, entitiesRefreshKey]);

  useRealtimeTransactions(
    canAccess && currentOrganization?.id ? currentOrganization.id : null,
    useCallback(() => setLedgerRefreshKey((k) => k + 1), []),
  );

  // Refetch trips + entities when Finance tab gains focus (skip first focus to avoid double-fetch on mount)
  // so new trips immediately show in customer sales, supplier payables, vehicle P&L, and ledger.
  const isFirstFinanceFocus = useRef(true);
  useFocusEffect(
    useCallback(() => {
      if (!canAccess || !currentOrganization?.id) return;
      if (isFirstFinanceFocus.current) {
        isFirstFinanceFocus.current = false;
        return;
      }
      setEntitiesRefreshKey((k) => k + 1);
      setLedgerRefreshKey((k) => k + 1);
    }, [canAccess, currentOrganization?.id]),
  );

  // Load ledger transactions on mount/refresh (used by Ledger tab and by Customers tab for ledger-only parties)
  useEffect(() => {
    if (!canAccess || !currentOrganization?.id) return;
    const shouldFetch =
      ledgerTransactions === null ||
      ledgerRefreshKey !== ledgerRefreshKeyRef.current;
    if (!shouldFetch) return;
    ledgerRefreshKeyRef.current = ledgerRefreshKey;
    setLedgerLoading(true);
    getTransactionsByOrganization(currentOrganization.id).then(
      ({ error, transactions }) => {
        setLedgerLoading(false);
        setLedgerTransactions(error ? [] : (transactions ?? []));
      },
    );
  }, [
    canAccess,
    currentOrganization?.id,
    ledgerRefreshKey,
    ledgerTransactions,
  ]);

  // Load driver_ledger when a driver is selected (for monthly statement). Refetch on ledgerRefreshKey.
  useEffect(() => {
    if (selectedEntity?.entityType !== "DRIVER" || !selectedEntity.data.id) {
      setSelectedDriverLedgerEntries(null);
      return;
    }
    let cancelled = false;
    setSelectedDriverLedgerEntries(null);
    getDriverLedgerByDriver(selectedEntity.data.id).then(
      ({ error, entries }) => {
        if (!cancelled && !error) setSelectedDriverLedgerEntries(entries ?? []);
      },
    );
    return () => {
      cancelled = true;
    };
  }, [selectedEntity?.entityType, selectedEntity?.data?.id, ledgerRefreshKey]);

  const filteredLedger = useMemo(
    () => filterLedgerByPeriod(ledgerTransactions ?? [], financePeriodFilter),
    [ledgerTransactions, financePeriodFilter],
  );

  /** O(n): trip count per partner key (contact_id or normalized party_name) for Shared Ledger. */
  const tripCountByParty = useMemo(() => {
    const tripIdsByKey = new Map<string, Set<string>>();
    const txs = ledgerTransactions ?? [];
    for (const row of txs) {
      const key =
        row.contact_type &&
        (row.contact_type === "client" || row.contact_type === "supplier") &&
        row.contact_id
          ? row.contact_id
          : (row.party_name ?? "").trim().toLowerCase() || "—";
      if (!tripIdsByKey.has(key)) tripIdsByKey.set(key, new Set());
      if (row.trip_id) tripIdsByKey.get(key)!.add(row.trip_id);
    }
    const out: Record<string, number> = {};
    tripIdsByKey.forEach((set, k) => {
      out[k] = set.size;
    });
    return out;
  }, [ledgerTransactions]);

  const ledgerSearchLower = searchQuery.trim().toLowerCase();
  const tripById = useMemo(
    () => new Map(tripRows.map((t) => [t.id, t])),
    [tripRows],
  );
  const garagePeriodOptions = useMemo(
    () => getAvailablePeriodOptions(tripRows),
    [tripRows],
  );
  const getVehicleNumberForTripId = useCallback(
    (tripId: string | null): string | null => {
      if (!tripId) return null;
      const trip = tripById.get(tripId);
      if (!trip?.vehicle_id) return null;
      const vehicle = vehicleRows.find((v) => v.id === trip.vehicle_id);
      return vehicle?.vehicle_number ?? null;
    },
    [tripById, vehicleRows],
  );

  const tripPartyMap = useMemo(() => {
    const map: Record<
      string,
      {
        client_id?: string | null;
        supplier_id?: string | null;
        driver_id?: string | null;
      }
    > = {};
    for (let i = 0; i < tripRows.length; i++) {
      const t = tripRows[i];
      map[t.id] = {
        client_id: t.client_id ?? null,
        supplier_id: t.supplier_id ?? null,
        driver_id: t.driver_id ?? null,
      };
    }
    return map;
  }, [tripRows]);
  const filteredLedgerBySource = useMemo(() => {
    if (sourceSupplyFilter === "all") return filteredLedger;
    return filteredLedger.filter((r) => {
      if (!r.trip_id) return true;
      const trip = tripById.get(r.trip_id);
      if (!trip) return true;
      const isAggregate = !!trip.supplier_id;
      return sourceSupplyFilter === "aggregate" ? isAggregate : !isAggregate;
    });
  }, [filteredLedger, sourceSupplyFilter, tripById]);
  const ledgerRowsByCategory = useMemo(() => {
    const match = (
      r: { contact_type?: "client" | "supplier" | "driver" | null },
      cat: LedgerCategory,
    ): boolean => {
      if (cat === "all") return true;
      const ct = r.contact_type;
      if (cat === "customers") return ct === "client";
      if (cat === "suppliers") return ct === "supplier";
      if (cat === "driver") return ct === "driver";
      if (cat === "vehicle") return ct != null ? false : true;
      return true;
    };
    return (base: typeof filteredLedgerBySource, cat: LedgerCategory) =>
      cat === "all" ? base : base.filter((r) => match(r, cat));
  }, []);

  const filteredLedgerForDisplay = useMemo(() => {
    let base = ledgerRowsByCategory(
      filteredLedgerBySource,
      selectedLedgerCategory,
    );
    if (cashDirectionFilter === "in") {
      base = base.filter((r) => (r.amount_in ?? 0) > 0);
    } else if (cashDirectionFilter === "out") {
      base = base.filter((r) => (r.amount_out ?? 0) > 0);
    }
    if (ledgerSearchLower) {
      base = base.filter(
        (r) =>
          (r.party_name || "").toLowerCase().includes(ledgerSearchLower) ||
          (r.description || "").toLowerCase().includes(ledgerSearchLower) ||
          (r.trip_number || "").toLowerCase().includes(ledgerSearchLower) ||
          (getVehicleNumberForTripId(r.trip_id ?? null) || "")
            .toLowerCase()
            .includes(ledgerSearchLower),
      );
    }
    const sorted = [...base].sort((a, b) => {
      const mult = ledgerSortDir === "asc" ? 1 : -1;
      if (ledgerSortKey === "entity") {
        const entityFor = (r: (typeof base)[0]) =>
          (r.amount_out ?? 0) > 0
            ? getVehicleNumberForTripId(r.trip_id ?? null) || r.party_name || ""
            : r.party_name || "";
        const nameA = entityFor(a);
        const nameB = entityFor(b);
        const nameCmp = nameA.localeCompare(nameB, undefined, {
          sensitivity: "base",
        });
        if (nameCmp !== 0) return mult * nameCmp;
        return mult * (a.description || "").localeCompare(b.description || "");
      }
      if (ledgerSortKey === "source") {
        const sourceA =
          a.trip_number || getVehicleNumberForTripId(a.trip_id ?? null) || "";
        const sourceB =
          b.trip_number || getVehicleNumberForTripId(b.trip_id ?? null) || "";
        return mult * sourceA.localeCompare(sourceB);
      }
      if (ledgerSortKey === "cash_in") {
        return mult * ((a.amount_in ?? 0) - (b.amount_in ?? 0));
      }
      if (ledgerSortKey === "cash_out") {
        return mult * ((a.amount_out ?? 0) - (b.amount_out ?? 0));
      }
      const dateA = a.transaction_date || a.created_at || "";
      const dateB = b.transaction_date || b.created_at || "";
      return mult * dateA.localeCompare(dateB);
    });
    return sorted;
  }, [
    filteredLedgerBySource,
    ledgerRowsByCategory,
    selectedLedgerCategory,
    cashDirectionFilter,
    ledgerSearchLower,
    ledgerSortKey,
    ledgerSortDir,
    getVehicleNumberForTripId,
  ]);

  const ledgerTotals = useMemo(
    () => ({
      totalIn: filteredLedgerBySource.reduce(
        (s, r) => s + (r.amount_in ?? 0),
        0,
      ),
      totalOut: filteredLedgerBySource.reduce(
        (s, r) => s + (r.amount_out ?? 0),
        0,
      ),
    }),
    [filteredLedgerBySource],
  );

  /** Count per category for the category picker. */
  const ledgerCategoryCounts = useMemo(() => {
    const base = filteredLedgerBySource;
    const match = (
      r: { contact_type?: "client" | "supplier" | "driver" | null },
      cat: LedgerCategory,
    ): boolean => {
      if (cat === "all") return true;
      const ct = r.contact_type;
      if (cat === "customers") return ct === "client";
      if (cat === "suppliers") return ct === "supplier";
      if (cat === "driver") return ct === "driver";
      if (cat === "vehicle") return ct == null;
      return true;
    };
    return {
      all: base.length,
      customers: base.filter((r) => match(r, "customers")).length,
      suppliers: base.filter((r) => match(r, "suppliers")).length,
      vehicle: base.filter((r) => match(r, "vehicle")).length,
      driver: base.filter((r) => match(r, "driver")).length,
    };
  }, [filteredLedgerBySource]);

  /** When a category is selected (not "all"), its total in/out and count. */
  const selectedEntityTotals = useMemo(() => {
    if (selectedLedgerCategory === "all") return null;
    return {
      totalIn: filteredLedgerForDisplay.reduce(
        (s, r) => s + (r.amount_in ?? 0),
        0,
      ),
      totalOut: filteredLedgerForDisplay.reduce(
        (s, r) => s + (r.amount_out ?? 0),
        0,
      ),
      count: filteredLedgerForDisplay.length,
    };
  }, [selectedLedgerCategory, filteredLedgerForDisplay]);

  const summaryLabels = SUMMARY_LABELS[financeSubTab];
  const bannerTotals = financeSubTab === "ledger" ? ledgerTotals : tabTotals;
  const showPeriodFilter = financeSubTab === "ledger";

  /**
   * Tab-level in/out entry: aligns with double-entry model (docs/CORE_ACCOUNTING_MODEL.md).
   * Stored as single row; logical pairs:
   * - Cash IN + client → Dr Cash/Bank, Cr AR (customer payment)
   * - Cash OUT + supplier → Dr AP, Cr Cash/Bank (supplier payment)
   * - Cash OUT + driver → Dr Driver Payable, Cr Cash/Bank (driver payment)
   * - Cash OUT + vehicle expense (Fuel/Maintenance/Toll etc.) → Dr Vehicle Expense, Cr Cash/Bank
   * Balance always computed from history; no direct balance edit.
   */
  const handleTransactionSubmit = useCallback(
    (data: AddTransactionData, options?: { entryId: string }) => {
      if (!currentOrganization?.id) return;
      const today = new Date().toISOString().slice(0, 10);
      const transactionDate =
        data.transactionDate && /^\d{4}-\d{2}-\d{2}$/.test(data.transactionDate)
          ? data.transactionDate.slice(0, 10)
          : options?.entryId && editingEntry?.transaction_date
            ? editingEntry.transaction_date.slice(0, 10)
            : today;
      const vehicleNumberFromEntity =
        selectedEntity?.entityType === "VEHICLE"
          ? (selectedEntity.data.name ?? null)
          : null;
      const isVehicleExpense =
        data.type === "out" && selectedEntity?.entityType === "VEHICLE";
      const driverPaymentLabelRaw =
        data.type === "out" &&
        data.driverPaymentType &&
        (() => {
          const found = DRIVER_PAYMENT_TYPES.find(
            (t) => t.type === data.driverPaymentType,
          );
          return found?.label ?? data.driverPaymentType;
        })();
      const driverPaymentLabel =
        typeof driverPaymentLabelRaw === "string"
          ? driverPaymentLabelRaw
          : undefined;
      const payload = {
        trip_id: data.tripId ?? null,
        trip_number: data.tripNumber ?? null,
        party_name: data.partyName || "—",
        description: (data.type === "in"
          ? (data.category ?? "ENTRY")
          : data.type === "out"
            ? (driverPaymentLabel ?? data.category ?? "ENTRY")
            : "ENTRY") as string,
        amount_in: data.type === "in" ? data.amount : 0,
        amount_out: data.type === "out" ? data.amount : 0,
        transaction_date: transactionDate,
        contact_id: data.contactId ?? null,
        contact_type: data.contactType ?? null,
        indent_id: data.indentId ?? null,
        vehicle_number: data.vehicleNumber ?? vehicleNumberFromEntity ?? null,
        driver_name: isVehicleExpense ? null : (data.driverName ?? null),
      };

      // Duplicate check (O(n)): same trip_id, contact_id, amount, date — warn, allow override
      if (!options?.entryId && (ledgerTransactions ?? []).length > 0) {
        const amountIn = payload.amount_in;
        const amountOut = payload.amount_out;
        const sameEntry = (ledgerTransactions ?? []).some((r) => {
          const sameTrip = (r.trip_id ?? null) === (payload.trip_id ?? null);
          const sameContact =
            (r.contact_id ?? null) === (payload.contact_id ?? null);
          const sameDate =
            (r.transaction_date ?? "").slice(0, 10) ===
            (payload.transaction_date ?? "").slice(0, 10);
          const sameAmount =
            (Number(r.amount_in ?? 0) === amountIn &&
              Number(r.amount_out ?? 0) === amountOut) ||
            (amountIn > 0 && Number(r.amount_in ?? 0) === amountIn) ||
            (amountOut > 0 && Number(r.amount_out ?? 0) === amountOut);
          return sameTrip && sameContact && sameDate && sameAmount;
        });
        if (sameEntry) {
          Alert.alert(
            "Similar entry exists",
            "An entry with the same trip, party, amount and date already exists. Add anyway?",
            [
              { text: "Cancel", style: "cancel" },
              {
                text: "Add anyway",
                onPress: () =>
                  doSubmit(
                    currentOrganization.id,
                    options,
                    payload,
                    data,
                    transactionDate,
                    driverPaymentLabel,
                    vehicleNumberFromEntity,
                    isVehicleExpense,
                    profile?.uid,
                    setLedgerTransactions,
                    setLedgerRefreshKey,
                    setEditingEntry,
                    setAddEntryContext,
                    setShowTransactionModal,
                  ),
              },
            ],
          );
          return;
        }
      }

      // Overpayment warning (do not block): client received > billed, or supplier paid > payables
      const runSubmit = () =>
        doSubmit(
          currentOrganization.id,
          options,
          payload,
          data,
          transactionDate,
          driverPaymentLabel,
          vehicleNumberFromEntity,
          isVehicleExpense,
          profile?.uid,
          setLedgerTransactions,
          setLedgerRefreshKey,
          setEditingEntry,
          setAddEntryContext,
          setShowTransactionModal,
        );

      if (
        !options?.entryId &&
        data.type === "in" &&
        data.contactType === "client" &&
        data.contactId
      ) {
        let billed = 0;
        for (let i = 0; i < tripRows.length; i++) {
          const t = tripRows[i];
          if (t.client_id === data.contactId)
            billed += Number(t.client_price ?? 0);
        }
        let received = 0;
        const txs = ledgerTransactions ?? [];
        for (let i = 0; i < txs.length; i++) {
          const r = txs[i];
          if (r.contact_type === "client" && r.contact_id === data.contactId)
            received += Number(r.amount_in ?? 0);
        }
        if (received + data.amount > billed && billed > 0) {
          Alert.alert(
            "Overpayment",
            "Received would exceed billed for this client. Continue anyway?",
            [
              { text: "Cancel", style: "cancel" },
              { text: "Continue", onPress: runSubmit },
            ],
          );
          return;
        }
      }
      if (
        !options?.entryId &&
        data.type === "out" &&
        data.contactType === "supplier" &&
        data.contactId
      ) {
        let payables = 0;
        for (let i = 0; i < tripRows.length; i++) {
          const t = tripRows[i];
          if (t.supplier_id === data.contactId)
            payables += Number(t.supplier_rate ?? 0);
        }
        let paid = 0;
        const txs = ledgerTransactions ?? [];
        for (let i = 0; i < txs.length; i++) {
          const r = txs[i];
          if (r.contact_type === "supplier" && r.contact_id === data.contactId)
            paid += Number(r.amount_out ?? 0);
        }
        if (paid + data.amount > payables && payables > 0) {
          Alert.alert(
            "Overpayment",
            "Paid would exceed payables for this supplier. Continue anyway?",
            [
              { text: "Cancel", style: "cancel" },
              { text: "Continue", onPress: runSubmit },
            ],
          );
          return;
        }
      }

      runSubmit();
    },
    [
      currentOrganization?.id,
      editingEntry?.transaction_date,
      profile?.uid,
      selectedEntity,
      ledgerTransactions,
      tripRows,
    ],
  );

  function doSubmit(
    orgId: string,
    options: AddTransactionSubmitOptions | undefined,
    payload: Parameters<typeof createLedgerEntry>[1],
    data: AddTransactionData,
    transactionDate: string,
    driverPaymentLabel: string | null | undefined,
    vehicleNumberFromEntity: string | null,
    isVehicleExpense: boolean,
    profileUid: string | null | undefined,
    setLedgerTransactions: React.Dispatch<
      React.SetStateAction<LedgerRow[] | null>
    >,
    setLedgerRefreshKey: (fn: (k: number) => number) => void,
    setEditingEntry: (e: LedgerRow | null) => void,
    setAddEntryContext: (c: TripEntryContext | null) => void,
    setShowTransactionModal: (v: boolean) => void,
  ) {
    const promise = options?.entryId
      ? updateLedgerEntry(orgId, options.entryId, payload)
      : createLedgerEntry(orgId, payload);
    promise.then(async ({ error, row: updatedRow }) => {
      if (!error) {
        if (options?.entryId && updatedRow) {
          setLedgerTransactions((prev) =>
            prev
              ? prev.map((r) => (r.id === options.entryId ? updatedRow : r))
              : prev,
          );
        }
        if (
          !options?.entryId &&
          data.contactType === "driver" &&
          data.type === "out" &&
          data.driverPaymentType &&
          data.contactId
        ) {
          const description =
            driverPaymentLabel != null && typeof driverPaymentLabel === "string"
              ? driverPaymentLabel
              : null;
          let ledgerPayload: {
            tripId: string | null;
            createdBy: string | null;
            description: string | null;
          } = {
            tripId: data.tripId ?? null,
            createdBy: profileUid ?? null,
            description,
          };
          const driverLedgerType =
            data.driverPaymentType === "bonus"
              ? "adjustment"
              : data.driverPaymentType;
          let { error: ledgerErr } = await createDriverLedgerEntry(
            orgId,
            data.contactId,
            data.amount,
            driverLedgerType,
            ledgerPayload,
          );
          // If created_by FK fails (user has no profile row), retry without it so payment is still recorded.
          if (ledgerErr?.message?.includes("driver_ledger_created_by_fkey")) {
            const retry = await createDriverLedgerEntry(
              orgId,
              data.contactId,
              data.amount,
              data.driverPaymentType,
              { ...ledgerPayload, createdBy: null },
            );
            ledgerErr = retry.error;
          }
          if (ledgerErr) {
            const msg = ledgerErr.message || "";
            const isSchemaError =
              /schema cache|table.*driver_ledger|relation.*driver_ledger|does not exist/i.test(
                msg,
              );
            Alert.alert(
              "Driver ledger",
              isSchemaError
                ? `Payment recorded in ledger. To show it in the driver's wallet, run the migration on the DB this app uses: npx supabase db push (remote) or npx supabase db push --local (local). If you already ran it, ensure .env EXPO_PUBLIC_SUPABASE_URL matches that project.\n\nError: ${msg}`
                : "Payment recorded but driver record could not be updated. " +
                    msg,
            );
          }
          if (salaryRequestIdToPayAfterSubmitRef.current) {
            await updateSalaryRequestStatus(
              salaryRequestIdToPayAfterSubmitRef.current,
              "paid",
            );
            setPendingDriverSalaryRequests((prev) =>
              prev.filter(
                (r) => r.id !== salaryRequestIdToPayAfterSubmitRef.current,
              ),
            );
            salaryRequestIdToPayAfterSubmitRef.current = null;
          }
        }
        setLedgerRefreshKey((k) => k + 1);
        setEntitiesRefreshKey((k) => k + 1);
        setEditingEntry(null);
        setAddEntryContext(null);
        setShowTransactionModal(false);
      } else
        Alert.alert(
          options?.entryId ? "Update failed" : "Transaction failed",
          error.message,
        );
    });
  }

  const handleEntityRowSelect = useCallback(
    (
      data: FinancialRowData,
      entityType: "CLIENT" | "SUPPLIER" | "VEHICLE" | "DRIVER",
      subTab: FinanceSubTab,
    ) => {
      setSelectedEntity({ data, entityType, subTab });
    },
    [],
  );

  const supplierPartyOptions = useMemo(
    (): PartyOption[] =>
      supplierRows.map((s) => ({
        id: s.id,
        name:
          (s.name || s.company_name || s.contact_person || "Supplier").trim() ||
          "Supplier",
      })),
    [supplierRows],
  );

  const supplierLinkedOrgIds = useMemo(() => {
    const m: Record<string, string> = {};
    supplierRows.forEach((s) => {
      const lid = (s as { linked_organization_id?: string | null })
        .linked_organization_id;
      if (lid) m[s.id] = lid;
    });
    return m;
  }, [supplierRows]);

  const driverPartyOptions = useMemo(
    (): PartyOption[] =>
      driverRows.map((d) => ({
        id: d.id,
        name: (d.name || "Driver").trim() || "Driver",
      })),
    [driverRows],
  );

  const vehicleOptions = useMemo(
    () =>
      vehicleRows.map((v) => ({
        id: v.id,
        vehicle_number: v.vehicle_number || v.id,
      })),
    [vehicleRows],
  );

  const defaultPartyId =
    selectedEntity?.entityType === "CLIENT" ||
    selectedEntity?.entityType === "SUPPLIER"
      ? selectedEntity.data.id
      : undefined;

  const selectedEntityTrips = useMemo((): TripRow[] => {
    if (!selectedEntity) return [];
    const { data: entity, entityType } = selectedEntity;
    if (entityType === "CLIENT") {
      const nameKey = (entity.name ?? "").toLowerCase().trim();
      return tripRows.filter(
        (t) =>
          t.client_id === entity.id ||
          (nameKey && (t.client_name || "").toLowerCase().trim() === nameKey),
      );
    }
    if (entityType === "SUPPLIER") {
      const supplierNameKey = (entity.name ?? "").toLowerCase().trim();
      const fromOwned = tripRows.filter(
        (t) =>
          t.supplier_id === entity.id ||
          (supplierNameKey &&
            !t.supplier_id &&
            (t.supplier_name ?? "").toLowerCase().trim() === supplierNameKey),
      );
      const linkedOrgId = (entity as { linked_organization_id?: string | null })
        .linked_organization_id;
      if (linkedOrgId) {
        const fromAsClient = tripsWhereOrgIsClient.filter(
          (t) => t.organization_id === linkedOrgId,
        );
        const seen = new Set(fromOwned.map((t) => t.id));
        for (const t of fromAsClient) {
          if (!seen.has(t.id)) {
            seen.add(t.id);
            fromOwned.push(t);
          }
        }
      }
      return fromOwned;
    }
    if (entityType === "DRIVER")
      return tripRows.filter((t) => t.driver_id === entity.id);
    if (entityType === "VEHICLE") {
      if (entity.id === "UNASSIGNED")
        return tripRows.filter((t) => !t.vehicle_id);
      return tripRows.filter((t) => t.vehicle_id === entity.id);
    }
    return [];
  }, [selectedEntity, tripRows, tripsWhereOrgIsClient]);

  /** When overlay is open for a client/supplier/vehicle, pass only that entity's trips to Add Transaction modal. */
  const modalTripOptions = useMemo((): TripOption[] => {
    if (selectedEntity && selectedEntityTrips.length > 0) {
      const isClientOrSupplier =
        selectedEntity.entityType === "CLIENT" ||
        selectedEntity.entityType === "SUPPLIER";
      const isVehicle = selectedEntity.entityType === "VEHICLE";
      if (isClientOrSupplier || isVehicle) {
        const entityId = selectedEntity.data.id;
        const isSupplier = selectedEntity.entityType === "SUPPLIER";
        return selectedEntityTrips.map((t) => ({
          id: t.id,
          trip_number: getTripDisplayNumber(t),
          client_id: t.client_id ?? null,
          client_name: t.client_name ?? null,
          supplier_id: isSupplier
            ? (t.supplier_id ?? entityId)
            : (t.supplier_id ?? null),
          driver_id: t.driver_id ?? null,
          vehicle_id: t.vehicle_id ?? null,
          indent_id: t.indent_id ?? null,
          route_label:
            [t.pickup_area, t.drop_location].filter(Boolean).join(" → ") ||
            null,
          trip_date: formatLedgerDate(t.pickup_date || t.created_at),
          ...(t.organization_id != null && {
            organization_id: t.organization_id,
          }),
        }));
      }
    }
    return trips;
  }, [selectedEntity, selectedEntityTrips, trips]);

  /** Trip-sourced totals for ledger integration: receivable (client_price) and payable (supplier_rate) from trips. */
  const tripSourcedTotals = useMemo(() => {
    let receivable = 0;
    let payable = 0;
    for (const t of tripRows) {
      if (t.client_id != null) receivable += Number(t.client_price ?? 0);
      if (t.supplier_id != null) payable += Number(t.supplier_rate ?? 0);
    }
    return { receivable, payable };
  }, [tripRows]);

  /** Map trip_id -> detail for ledger SOURCE column (route, client, date, vehicle). */
  const tripDetailsMap = useMemo(() => {
    const map: Record<
      string,
      {
        trip_number: string;
        drop_location?: string;
        pickup_area?: string;
        client_name?: string;
        pickup_date?: string | null;
        vehicle_number?: string | null;
      }
    > = {};
    for (const t of tripRows) {
      const vehicleNumber = t.vehicle_id
        ? (vehicleRows.find((v) => v.id === t.vehicle_id)?.vehicle_number ??
          null)
        : null;
      map[t.id] = {
        trip_number: getTripDisplayNumber(t),
        drop_location: t.drop_location || undefined,
        pickup_area: t.pickup_area || undefined,
        client_name: t.client_name || undefined,
        pickup_date: t.pickup_date ?? t.created_at ?? undefined,
        vehicle_number: vehicleNumber ?? undefined,
      };
    }
    return map;
  }, [tripRows, vehicleRows]);

  const selectedEntityTransactions = useMemo((): LedgerRow[] | null => {
    if (!selectedEntity) return null;
    const allTx = ledgerTransactions ?? [];
    const { data: entity, entityType } = selectedEntity;
    if (entityType === "VEHICLE") {
      const tripIds = new Set(selectedEntityTrips.map((t) => t.id));
      return allTx.filter(
        (tx) => tx.trip_id != null && tripIds.has(tx.trip_id),
      );
    }
    if (entityType === "DRIVER") {
      const driverId = entity.id == null ? "" : String(entity.id).trim();
      return allTx.filter(
        (tx) =>
          tx.contact_type === "driver" &&
          tx.contact_id != null &&
          String(tx.contact_id).trim() === driverId,
      );
    }
    if (entityType !== "CLIENT" && entityType !== "SUPPLIER") return null;
    if (allTx.length === 0) return null;
    const contactType = entityType === "CLIENT" ? "client" : "supplier";
    if (entity.id.startsWith("ledger-party-")) {
      const nameKey = (entity.name ?? "").toLowerCase().trim();
      return nameKey
        ? allTx.filter(
            (tx) => (tx.party_name || "").toLowerCase().trim() === nameKey,
          )
        : [];
    }
    return allTx.filter(
      (tx) => tx.contact_type === contactType && tx.contact_id === entity.id,
    );
  }, [selectedEntity, selectedEntityTrips, ledgerTransactions]);

  const handleTabPress = useCallback((tabId: FinanceSubTab) => {
    setFinanceSubTab(tabId);
  }, []);

  const handleLedgerRowSelect = useCallback(
    (data: FinancialRowData) => {
      if (data.tripId) router.push(`/trip/${data.tripId}`);
    },
    [router],
  );

  const handleLedgerMissionChange = useCallback(
    async (entryId: string, tripId: string) => {
      const orgId = currentOrganization?.id;
      if (!orgId) return;
      const row = filteredLedgerForDisplay.find((r) => r.id === entryId);
      if (!row) return;
      const { error } = await updateLedgerEntry(orgId, entryId, {
        trip_id: tripId,
        party_name: row.party_name,
        description: row.description ?? "ENTRY",
        amount_in: row.amount_in,
        amount_out: row.amount_out,
        transaction_date: row.transaction_date,
        contact_id: row.contact_id ?? undefined,
        contact_type: row.contact_type ?? undefined,
      });
      if (!error) setLedgerRefreshKey((k) => k + 1);
    },
    [currentOrganization?.id, filteredLedgerForDisplay],
  );

  const NO_ORG_MESSAGE =
    "No organization loaded. Sign out and sign in again to refresh, or ensure you are added as a member of an organization in the dashboard.";

  const handleAddClientComplete = useCallback(
    async (data: AddClientFormData) => {
      if (!currentOrganization?.id) throw new Error(NO_ORG_MESSAGE);
      const { error } = await createClient(currentOrganization.id, {
        contact_person: data.contactPerson,
        phone: data.phone,
        organization_name: data.organizationName || undefined,
      });
      if (error) throw error;
      setEntitiesRefreshKey((k) => k + 1);
      setShowAddClientModal(false);
    },
    [currentOrganization?.id],
  );

  const searchInviteeByPhone = useCallback(async (phone: string) => {
    const { error, invitee } = await getConnectionInviteeByPhone(phone);
    if (error || !invitee) return null;
    return {
      organization_id: invitee.organization_id,
      full_name: invitee.full_name,
      phone: invitee.phone,
    };
  }, []);

  const handleSendClientInvitation = useCallback(
    async (toOrgId: string) => {
      if (!currentOrganization?.id) throw new Error(NO_ORG_MESSAGE);
      const { error } = await createConnectionRequest(
        currentOrganization.id,
        toOrgId,
        {
          requestShipperClient: true,
          requestCarrierSupplier: false,
        },
      );
      if (error) throw error;
      setEntitiesRefreshKey((k) => k + 1);
      setShowAddClientModal(false);
    },
    [currentOrganization?.id],
  );

  const handleSendSupplierInvitation = useCallback(
    async (toOrgId: string) => {
      if (!currentOrganization?.id) throw new Error(NO_ORG_MESSAGE);
      const { error } = await createConnectionRequest(
        currentOrganization.id,
        toOrgId,
        {
          requestShipperClient: false,
          requestCarrierSupplier: true,
        },
      );
      if (error) throw error;
      setEntitiesRefreshKey((k) => k + 1);
      setShowAddSupplierModal(false);
    },
    [currentOrganization?.id],
  );

  const handleAddVehicleComplete = useCallback(
    async (payload: AddVehicleCompletePayload) => {
      if (!currentOrganization?.id) throw new Error(NO_ORG_MESSAGE);
      const { error } = await createVehicle(currentOrganization.id, {
        vehicleSource: payload.vehicleSource,
        vehicle_number: payload.vehicleNumber,
        vehicle_type: payload.vehicleType,
        capacity: payload.capacity,
        vehicle_brand: payload.vehicleBrand ?? null,
        vehicle_model: payload.vehicleModel ?? null,
        vehicle_body_type: payload.vehicleBodyType ?? null,
        vehicle_size: payload.vehicleSize ?? null,
        vehicle_axle: payload.vehicleAxle ?? null,
        documents: payload.documents,
      });
      if (error) throw error;
      setEntitiesRefreshKey((k) => k + 1);
      setShowAddVehicleModal(false);
    },
    [currentOrganization?.id],
  );

  const handleAddDriverInviteComplete = useCallback(
    async (data: DriverFormData) => {
      if (!currentOrganization?.id) throw new Error(NO_ORG_MESSAGE);
      const { error, inviteSent } = await inviteDriver(
        currentOrganization.id,
        data,
        currentOrganization.name ?? undefined,
      );
      if (error) throw error;
      setEntitiesRefreshKey((k) => k + 1);
      setShowAddDriverModal(false);
      if (!inviteSent) {
        Alert.alert(
          "Driver added",
          'They\'ll see the invitation in the app once they sign up with this phone number (choose "Driver" when signing up). You can assign trips to them after they accept.',
        );
      }
    },
    [currentOrganization?.id],
  );

  const handleAddDriverDirect = useCallback(
    async (data: DriverFormData) => {
      if (!currentOrganization?.id) throw new Error(NO_ORG_MESSAGE);
      const { error } = await createDriver(currentOrganization.id, data);
      if (error) throw error;
      setEntitiesRefreshKey((k) => k + 1);
      setShowAddDriverModal(false);
    },
    [currentOrganization?.id],
  );

  const handleAddSupplierComplete = useCallback(
    async (data: SupplierFormData) => {
      if (!currentOrganization?.id) throw new Error(NO_ORG_MESSAGE);
      const { error } = await createSupplier(currentOrganization.id, {
        company_name: data.companyName || undefined,
        contact_person: data.name,
        phone: data.phone,
      });
      if (error) throw error;
      setEntitiesRefreshKey((k) => k + 1);
      setShowAddSupplierModal(false);
    },
    [currentOrganization?.id],
  );

  if (!canAccess) {
    return (
      <View style={[styles.centered, { paddingTop: insets.top }]}>
        <Text style={styles.message}>You don't have access to Finance.</Text>
      </View>
    );
  }

  const orgId = currentOrganization?.id ?? null;

  if (!orgId) {
    return (
      <View style={styles.container}>
        <View style={[styles.darkBlock, { paddingTop: 0 }]}>
          <TeslaHeader
            title="Treasury"
            subtitle="Fiscal Matrix"
            onLoadClick={() => router.push("/load-board")}
            onNetworkClick={() => router.push("/(tabs)/network")}
            onProfileClick={() => router.push("/(tabs)/profile")}
          />
        </View>
        <View
          style={[styles.centered, { flex: 1, paddingTop: insets.top + 24 }]}
        >
          <Text style={styles.message}>No organization.</Text>
          <Text
            style={[
              styles.message,
              { fontSize: 14, marginTop: 8, opacity: 0.8 },
            ]}
          >
            Add or select an organization in Profile to view the Fiscal Matrix.
          </Text>
        </View>
      </View>
    );
  }

  return (
    <View style={styles.container} testID="finance-tab-screen">
      <View style={[styles.darkBlock, { paddingTop: 0 }]}>
        <TeslaHeader
          title="Treasury"
          subtitle="Fiscal Matrix"
          onLoadClick={() => router.push("/load-board")}
          onNetworkClick={() => router.push("/(tabs)/network")}
          onProfileClick={() => router.push("/(tabs)/profile")}
        />
        <View style={styles.darkBlockContent}>
          <TreasurySummaryCard
            fullWidth
            topContent={
              <ScrollView
                horizontal
                showsHorizontalScrollIndicator={false}
                style={styles.fiscalTabScroll}
                contentContainerStyle={[
                  styles.fiscalTabRow,
                  {
                    minWidth: Math.max(
                      screenWidth,
                      TABS.length * MIN_FISCAL_TAB_WIDTH,
                    ),
                  },
                ]}
              >
                {TABS.map((tab) => {
                  const isActive = financeSubTab === tab.id;
                  return (
                    <TouchableOpacity
                      key={tab.id}
                      style={[
                        styles.fiscalTab,
                        isActive && styles.fiscalTabActive,
                      ]}
                      onPress={() => handleTabPress(tab.id)}
                      activeOpacity={0.7}
                    >
                      <Text
                        style={[
                          styles.fiscalTabText,
                          isActive && styles.fiscalTabTextActive,
                        ]}
                        numberOfLines={1}
                        adjustsFontSizeToFit
                      >
                        {tab.label}
                      </Text>
                      {isActive && <View style={styles.fiscalTabUnderline} />}
                    </TouchableOpacity>
                  );
                })}
              </ScrollView>
            }
            totalIn={bannerTotals.totalIn}
            totalOut={bannerTotals.totalOut}
            labelIn={summaryLabels.in}
            labelOut={summaryLabels.out}
            cashDirectionFilter={
              financeSubTab === "ledger" ? cashDirectionFilter : undefined
            }
            onCashInPress={
              financeSubTab === "ledger"
                ? () =>
                    setCashDirectionFilter((f) => (f === "in" ? "all" : "in"))
                : undefined
            }
            onCashOutPress={
              financeSubTab === "ledger"
                ? () =>
                    setCashDirectionFilter((f) => (f === "out" ? "all" : "out"))
                : undefined
            }
            searchQuery={searchQuery}
            onSearchChange={setSearchQuery}
            searchPlaceholder={
              financeSubTab === "ledger"
                ? "Search party, description…"
                : "Search entities…"
            }
            onReportPress={() => setShowReportModal(true)}
            entityFilter={financeSubTab === "ledger" ? undefined : entityFilter}
            onEntityFilterChange={
              financeSubTab === "ledger" ? undefined : setEntityFilter
            }
            entityFilterLabels={
              financeSubTab === "garage"
                ? { has_due: "Has expense", no_due: "No expense" }
                : undefined
            }
            garagePeriodOptions={
              financeSubTab === "garage" && garagePeriodOptions.length > 0
                ? garagePeriodOptions
                : undefined
            }
            garagePeriod={
              financeSubTab === "garage" ? garagePeriod : undefined
            }
            onGaragePeriodChange={
              financeSubTab === "garage" ? setGaragePeriod : undefined
            }
            garageViewTab={
              financeSubTab === "garage" ? garageViewTab : undefined
            }
            onGarageViewTabChange={
              financeSubTab === "garage" ? setGarageViewTab : undefined
            }
            showPeriodFilter={showPeriodFilter}
            periodFilter={financePeriodFilter}
            onPeriodFilterChange={setFinancePeriodFilter}
            sourceFilter={
              financeSubTab === "ledger" ? sourceSupplyFilter : undefined
            }
            onSourceFilterChange={
              financeSubTab === "ledger" ? setSourceSupplyFilter : undefined
            }
          />
        </View>
      </View>

      <ScrollView
        style={styles.tableScroll}
        contentContainerStyle={[
          styles.tableContent,
          { paddingBottom: 24 + insets.bottom + 120 },
        ]}
        showsVerticalScrollIndicator={false}
        onScrollBeginDrag={onScrollBeginDrag}
        onScrollEndDrag={onScrollEnd}
        onMomentumScrollEnd={onScrollEnd}
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={() => {
              setRefreshing(true);
              setLedgerRefreshKey((k) => k + 1);
              setEntitiesRefreshKey((k) => k + 1);
            }}
            tintColor={Theme.teslaRed}
          />
        }
      >
        {currentOrganization?.id && (
          <View style={styles.aiInsightsWrap}>
            <AIInsightsPanel organizationId={currentOrganization.id} />
          </View>
        )}
        {/* Table header — white bar: Garrage = VEHICLE | TRIPS | REVENUE | PROFIT; other tabs = ENTITY/DESC | SOURCE | SALES | EXP. */}
        <View style={styles.tableHeaderWrap}>
          <View style={styles.tableHeader}>
            {financeSubTab === "garage" ? (
              <>
                <Text style={[styles.th, styles.thNode]} numberOfLines={1}>
                  VEHICLE
                </Text>
                <Text
                  style={[styles.th, styles.thCenter, styles.thMission]}
                  numberOfLines={1}
                >
                  TRIPS
                </Text>
                <Text
                  style={[styles.th, styles.thRight, styles.thCredit]}
                  numberOfLines={1}
                >
                  SALES
                </Text>
                <Text
                  style={[styles.th, styles.thRight, styles.thDebit]}
                  numberOfLines={1}
                >
                  PROFIT
                </Text>
              </>
            ) : (
              <>
                {financeSubTab === "ledger" ? (
                  <TouchableOpacity
                    style={[styles.thNode]}
                    onPress={() => {
                      setLedgerSortKey("entity");
                      setLedgerSortDir("asc");
                      setShowEntityListModal(true);
                    }}
                    hitSlop={8}
                    accessibilityLabel="Party or item — who gave or took money. Tap to sort or filter."
                    accessibilityRole="button"
                  >
                    <Text style={styles.thText} numberOfLines={1}>
                      PARTY / ITEM
                      {ledgerSortKey === "entity"
                        ? ledgerSortDir === "desc"
                          ? " ↓"
                          : " ↑"
                        : ""}
                    </Text>
                  </TouchableOpacity>
                ) : (
                  <Text
                    style={[
                      styles.th,
                      financeSubTab === "customers"
                        ? styles.thNodeCust
                        : financeSubTab === "drivers"
                          ? styles.thNodeDriver
                          : styles.thNode,
                    ]}
                    numberOfLines={1}
                  >
                    {financeSubTab === "drivers" ? "DRIVER" : "PARTY / ITEM"}
                  </Text>
                )}
                {financeSubTab === "ledger" ? (
                  <TouchableOpacity
                    style={[
                      styles.th,
                      styles.thCenterView,
                      styles.thMission,
                      styles.thBorderLeft,
                    ]}
                    onPress={() => {
                      if (ledgerSortKey === "source") {
                        setLedgerSortDir((d) => (d === "asc" ? "desc" : "asc"));
                      } else {
                        setLedgerSortKey("source");
                        setLedgerSortDir("asc");
                      }
                    }}
                    hitSlop={8}
                    accessibilityLabel="Trip or route — which journey this entry is for. Tap to sort."
                    accessibilityRole="button"
                  >
                    <Text
                      style={[styles.thText, styles.thCenter]}
                      numberOfLines={1}
                    >
                      TRIP / ROUTE
                      {ledgerSortKey === "source"
                        ? ledgerSortDir === "desc"
                          ? " ↓"
                          : " ↑"
                        : ""}
                    </Text>
                  </TouchableOpacity>
                ) : (
                  <>
                    {(financeSubTab === "customers" ||
                      financeSubTab === "suppliers") && (
                      <Text
                        style={[
                          styles.th,
                          styles.thCenter,
                          styles.thTripsCust,
                          styles.thBorderLeft,
                        ]}
                        numberOfLines={1}
                      >
                        TRIPS
                      </Text>
                    )}
                    <Text
                      style={[
                        styles.th,
                        styles.thCenter,
                        financeSubTab === "customers"
                          ? styles.thMissionCust
                          : financeSubTab === "drivers"
                            ? styles.thStatusDriver
                            : financeSubTab === "suppliers"
                              ? styles.thMissionCust
                              : styles.thMission,
                        styles.thBorderLeft,
                      ]}
                      numberOfLines={1}
                    >
                      {financeSubTab === "customers"
                        ? "SALES"
                        : financeSubTab === "suppliers"
                          ? "SALES"
                          : financeSubTab === "drivers"
                            ? "STATUS"
                            : "TRIP / ROUTE"}
                    </Text>
                  </>
                )}
                {financeSubTab === "ledger" ? (
                  <TouchableOpacity
                    style={[
                      styles.thCol,
                      styles.thColLedgerAmount,
                      styles.thWithFilter,
                      styles.thBorderLeft,
                    ]}
                    onPress={() => {
                      if (ledgerSortKey === "cash_in") {
                        setLedgerSortDir((d) => (d === "asc" ? "desc" : "asc"));
                      } else {
                        setLedgerSortKey("cash_in");
                        setLedgerSortDir("desc");
                      }
                    }}
                    hitSlop={8}
                    accessibilityLabel="Cash in — money received. Tap to sort by amount."
                    accessibilityRole="button"
                  >
                    <Text
                      style={[styles.thText, styles.thRight]}
                      numberOfLines={1}
                    >
                      CASH IN
                      {ledgerSortKey === "cash_in"
                        ? ledgerSortDir === "desc"
                          ? " ↓"
                          : " ↑"
                        : ""}
                    </Text>
                  </TouchableOpacity>
                ) : (
                  <Text
                    style={[
                      styles.th,
                      styles.thRight,
                      financeSubTab === "customers"
                        ? styles.thCreditCust
                        : financeSubTab === "drivers"
                          ? styles.thCreditDriver
                          : styles.thCredit,
                      styles.thBorderLeft,
                    ]}
                    numberOfLines={1}
                  >
                    {financeSubTab === "customers"
                      ? "COLLECTED"
                      : financeSubTab === "suppliers"
                        ? "PAID"
                        : financeSubTab === "drivers"
                          ? "TO PAY"
                          : financeSubTab === "garage"
                            ? "EXPENSES"
                            : "SALES"}
                  </Text>
                )}
                {financeSubTab === "ledger" ? (
                  <TouchableOpacity
                    style={[
                      styles.thCol,
                      styles.thColLedgerAmount,
                      styles.thWithFilter,
                      styles.thBorderLeft,
                    ]}
                    onPress={() => {
                      if (ledgerSortKey === "cash_out") {
                        setLedgerSortDir((d) => (d === "asc" ? "desc" : "asc"));
                      } else {
                        setLedgerSortKey("cash_out");
                        setLedgerSortDir("desc");
                      }
                    }}
                    hitSlop={8}
                    accessibilityLabel="Cash out — money paid. Tap to sort by amount."
                    accessibilityRole="button"
                  >
                    <Text
                      style={[styles.thText, styles.thRight]}
                      numberOfLines={1}
                    >
                      CASH OUT
                      {ledgerSortKey === "cash_out"
                        ? ledgerSortDir === "desc"
                          ? " ↓"
                          : " ↑"
                        : ""}
                    </Text>
                  </TouchableOpacity>
                ) : (
                  <View
                    style={[
                      styles.thCol,
                      styles.thWithFilter,
                      financeSubTab === "customers"
                        ? styles.thDebitCust
                        : financeSubTab === "drivers"
                          ? styles.thDebitDriver
                          : styles.thDebit,
                      styles.thBorderLeft,
                    ]}
                  >
                    <Text style={styles.thText} numberOfLines={1}>
                      {LAST_COL_LABEL[financeSubTab]}
                    </Text>
                  </View>
                )}
                {financeSubTab === "ledger" && (
                  <View style={styles.thLedgerSpacer} />
                )}
              </>
            )}
          </View>
        </View>

        {financeSubTab === "ledger" &&
          selectedLedgerCategory !== "all" && (
            <View style={styles.ledgerEntityFilterBanner}>
              <View style={styles.ledgerEntityFilterBannerAccent} />
              <View style={styles.ledgerEntityFilterBannerContent}>
                <View style={styles.ledgerEntityFilterLabelRow}>
                  <View style={styles.ledgerEntityFilterIconWrap}>
                    <FontAwesome name="filter" size={11} color={Theme.teslaRed} />
                  </View>
                  <Text style={styles.ledgerEntityFilterLabel}>Category</Text>
                  <View style={styles.ledgerEntityFilterBadge}>
                    <Text style={styles.ledgerEntityFilterText} numberOfLines={1}>
                      {selectedLedgerCategory === "customers"
                        ? "CUSTOMERS"
                        : selectedLedgerCategory === "suppliers"
                          ? "SUPPLIERS"
                          : selectedLedgerCategory === "vehicle"
                            ? "VEHICLE"
                            : "DRIVER"}
                    </Text>
                  </View>
                </View>
                {selectedEntityTotals != null && (
                  <>
                    <View style={styles.ledgerEntityFilterStatsRow}>
                      <Pressable
                        style={({ pressed }) => [
                          styles.ledgerEntityFilterStat,
                          pressed && styles.ledgerEntityFilterStatPressed,
                        ]}
                        accessibilityRole="button"
                        accessibilityLabel={`${selectedEntityTotals.count} transactions`}
                      >
                        <Text style={styles.ledgerEntityFilterStatValue}>
                          {selectedEntityTotals.count}
                        </Text>
                        <Text style={styles.ledgerEntityFilterStatUnit}>tx</Text>
                      </Pressable>
                      <Pressable
                        style={({ pressed }) => [
                          styles.ledgerEntityFilterStat,
                          styles.ledgerEntityFilterStatIn,
                          pressed && styles.ledgerEntityFilterStatPressed,
                        ]}
                        accessibilityRole="button"
                        accessibilityLabel={`Cash in ${selectedEntityTotals.totalIn.toLocaleString("en-IN", { maximumFractionDigits: 0 })}`}
                      >
                        <FontAwesome name="arrow-up" size={9} color={Theme.darkGreen} />
                        <Text style={styles.ledgerEntityFilterStatAmountGreen}>
                          ₹{selectedEntityTotals.totalIn.toLocaleString("en-IN", {
                            maximumFractionDigits: 0,
                          })}
                        </Text>
                      </Pressable>
                      <Pressable
                        style={({ pressed }) => [
                          styles.ledgerEntityFilterStat,
                          styles.ledgerEntityFilterStatOut,
                          pressed && styles.ledgerEntityFilterStatPressed,
                        ]}
                        accessibilityRole="button"
                        accessibilityLabel={`Cash out ${selectedEntityTotals.totalOut.toLocaleString("en-IN", { maximumFractionDigits: 0 })}`}
                      >
                        <FontAwesome name="arrow-down" size={9} color={Theme.teslaRed} />
                        <Text style={styles.ledgerEntityFilterStatAmountRed}>
                          ₹{selectedEntityTotals.totalOut.toLocaleString("en-IN", {
                            maximumFractionDigits: 0,
                          })}
                        </Text>
                      </Pressable>
                    </View>
                    {selectedEntityTotals.totalIn + selectedEntityTotals.totalOut > 0 && (
                      <View style={styles.ledgerEntityFilterRatioBarWrap}>
                        <View
                          style={[
                            styles.ledgerEntityFilterRatioBarIn,
                            {
                              flex: selectedEntityTotals.totalIn,
                            },
                          ]}
                          accessibilityLabel="Cash in share"
                          accessibilityRole="none"
                        />
                        <View
                          style={[
                            styles.ledgerEntityFilterRatioBarOut,
                            {
                              flex: selectedEntityTotals.totalOut,
                            },
                          ]}
                          accessibilityLabel="Cash out share"
                          accessibilityRole="none"
                        />
                      </View>
                    )}
                  </>
                )}
              </View>
              <Pressable
                onPress={() => setSelectedLedgerCategory("all")}
                hitSlop={12}
                style={({ pressed }) => [
                  styles.ledgerEntityFilterClear,
                  pressed && styles.ledgerEntityFilterClearPressed,
                ]}
                accessibilityLabel="Clear category filter"
                accessibilityRole="button"
              >
                <FontAwesome name="times" size={10} color={Theme.textOnDark} />
                <Text style={styles.ledgerEntityFilterClearText}>Clear</Text>
              </Pressable>
            </View>
          )}

        {financeSubTab === "ledger" &&
          (tripSourcedTotals.receivable > 0 ||
            tripSourcedTotals.payable > 0) && (
            <View style={styles.ledgerTripSummaryWrap}>
              <View style={styles.ledgerTripSummaryAccent} />
              <View style={styles.ledgerTripSummaryIconWrap}>
                <FontAwesome name="road" size={12} color={Theme.textSecondary} />
              </View>
              <View style={styles.ledgerTripSummaryContent}>
                <Text style={styles.ledgerTripSummaryLabel}>From trips</Text>
                <View style={styles.ledgerTripSummaryRow}>
                  <Pressable
                    style={({ pressed }) => [
                      styles.ledgerTripSummaryChip,
                      pressed && styles.ledgerTripSummaryChipPressed,
                    ]}
                    accessibilityRole="button"
                    accessibilityLabel={`Receivable ${tripSourcedTotals.receivable.toLocaleString("en-IN", { maximumFractionDigits: 0 })}`}
                  >
                    <FontAwesome name="arrow-up" size={9} color={Theme.darkGreen} />
                    <Text style={styles.ledgerTripSummaryChipLabel}>Receivable</Text>
                    <Text style={styles.ledgerTripSummaryChipValueGreen}>
                      ₹{tripSourcedTotals.receivable.toLocaleString("en-IN", {
                        maximumFractionDigits: 0,
                      })}
                    </Text>
                  </Pressable>
                  <Pressable
                    style={({ pressed }) => [
                      styles.ledgerTripSummaryChip,
                      pressed && styles.ledgerTripSummaryChipPressed,
                    ]}
                    accessibilityRole="button"
                    accessibilityLabel={`Payable ${tripSourcedTotals.payable.toLocaleString("en-IN", { maximumFractionDigits: 0 })}`}
                  >
                    <FontAwesome name="arrow-down" size={9} color={Theme.teslaRed} />
                    <Text style={styles.ledgerTripSummaryChipLabel}>Payable</Text>
                    <Text style={styles.ledgerTripSummaryChipValueRed}>
                      ₹{tripSourcedTotals.payable.toLocaleString("en-IN", {
                        maximumFractionDigits: 0,
                      })}
                    </Text>
                  </Pressable>
                </View>
              </View>
            </View>
          )}

        <View style={styles.tableBodyWrap}>
          {financeSubTab === "ledger" &&
            (ledgerLoading && ledgerTransactions === null ? (
              <Text style={styles.ledgerLoading}>Loading…</Text>
            ) : (
              <LedgerTab
                organizationId={orgId}
                refreshKey={ledgerRefreshKey}
                transactions={
                  ledgerTransactions !== null
                    ? filteredLedgerForDisplay
                    : undefined
                }
                onRowSelect={handleLedgerRowSelect}
                onEntitySelect={() => {}}
                getVehicleNumberForTripId={getVehicleNumberForTripId}
                tripOptions={trips}
                tripDetailsMap={tripDetailsMap}
                onMissionChange={handleLedgerMissionChange}
              />
            ))}
          {financeSubTab === "customers" && (
            <CustomersTab
              organizationId={orgId}
              clients={clientRows}
              trips={tripRows}
              transactions={ledgerTransactions ?? undefined}
              parentLoading={entitiesLoading}
              onTotals={setTabTotals}
              onRowSelect={handleEntityRowSelect}
              searchQuery={searchQuery}
              entityFilter={entityFilter}
              pendingClientInvites={connectionRequestsSent.filter(
                (r) => r.request_shipper_client && r.status === "pending",
              )}
              tripPartyMap={tripPartyMap}
            />
          )}
          {financeSubTab === "suppliers" && (
            <SuppliersTab
              organizationId={orgId}
              suppliers={supplierRows}
              trips={tripRows}
              tripsWhereOrgIsClient={tripsWhereOrgIsClient}
              transactions={ledgerTransactions ?? undefined}
              parentLoading={entitiesLoading}
              onTotals={setTabTotals}
              onRowSelect={handleEntityRowSelect}
              searchQuery={searchQuery}
              entityFilter={entityFilter}
              pendingSupplierInvites={connectionRequestsSent.filter(
                (r) => r.request_carrier_supplier && r.status === "pending",
              )}
              tripPartyMap={tripPartyMap}
            />
          )}
          {financeSubTab === "garage" && (
            <GarrageTab
              organizationId={orgId}
              vehicles={vehicleRows}
              trips={tripRows}
              transactions={ledgerTransactions ?? undefined}
              parentLoading={entitiesLoading}
              onTotals={setTabTotals}
              onRowSelect={handleEntityRowSelect}
              garagePeriod={garagePeriod}
              onGaragePeriodChange={setGaragePeriod}
              viewTab={garageViewTab}
              onViewTabChange={setGarageViewTab}
              searchQuery={searchQuery}
              entityFilter={entityFilter}
              onTripSelect={(tripId) => router.push(`/trip/${tripId}` as const)}
            />
          )}
          {financeSubTab === "drivers" && (
            <>
              {pendingDriverSalaryRequests.length > 0 && (
                <View style={styles.driverSalaryRequestsBlock}>
                  <Text style={styles.driverSalaryRequestsTitle}>
                    Requests from drivers
                  </Text>
                  <Text style={styles.driverSalaryRequestsSubtitle}>
                    Pay or reject salary requests sent by drivers.
                  </Text>
                  {pendingDriverSalaryRequests.map((req) => {
                    const driverName =
                      req.drivers?.name?.trim() ||
                      driverRows.find((d) => d.id === req.driver_id)?.name ||
                      "Driver";
                    const typeLabel =
                      req.request_type === "monthly"
                        ? "Monthly salary"
                        : req.request_type === "advance"
                          ? "Advance"
                          : "Trip-based";
                    const salaryMonthStr =
                      req.request_type === "monthly" && req.salary_month
                        ? (() => {
                            const d = new Date(req.salary_month);
                            return d.toLocaleDateString("en-IN", {
                              month: "short",
                              year: "numeric",
                            });
                          })()
                        : null;
                    const dateStr = req.created_at
                      ? formatLedgerDate(req.created_at)
                      : "";
                    return (
                      <View key={req.id} style={styles.driverSalaryRequestCard}>
                        <View style={styles.driverSalaryRequestCardMain}>
                          <Text
                            style={styles.driverSalaryRequestDriverName}
                            numberOfLines={1}
                          >
                            {driverName}
                          </Text>
                          <Text
                            style={styles.driverSalaryRequestMeta}
                            numberOfLines={1}
                          >
                            {typeLabel}
                            {salaryMonthStr ? ` · ${salaryMonthStr}` : ""}
                            {dateStr ? ` · ${dateStr}` : ""}
                          </Text>
                          {req.note?.trim() ? (
                            <Text
                              style={styles.driverSalaryRequestNote}
                              numberOfLines={2}
                            >
                              {req.note.trim()}
                            </Text>
                          ) : null}
                          <View style={styles.driverSalaryRequestAmountRow}>
                            <Text style={styles.driverSalaryRequestAmount}>
                              ₹{Number(req.amount).toLocaleString("en-IN")}
                            </Text>
                          </View>
                        </View>
                        <View style={styles.driverSalaryRequestActions}>
                          <TouchableOpacity
                            style={[
                              styles.driverSalaryRequestBtn,
                              styles.driverSalaryRequestBtnPay,
                            ]}
                            onPress={() => {
                              const driver = driverRows.find(
                                (d) => d.id === req.driver_id,
                              );
                              if (!driver) {
                                Alert.alert(
                                  "Driver not found",
                                  "This driver may have been removed.",
                                );
                                return;
                              }
                              salaryRequestIdToPayAfterSubmitRef.current =
                                req.id;
                              setSelectedEntity({
                                data: {
                                  ...driver,
                                  id: driver.id,
                                  name: driver.name,
                                  subline: typeLabel,
                                  pending: Number(req.amount),
                                  due: Number(req.amount),
                                } as FinancialRowData,
                                entityType: "DRIVER",
                                subTab: "drivers",
                              });
                              setAddEntryContext(null);
                              setShowTransactionModal(true);
                            }}
                            accessibilityLabel="Pay this request"
                          >
                            <FontAwesome
                              name="rupee"
                              size={14}
                              color={Theme.textOnPrimary}
                            />
                            <Text style={styles.driverSalaryRequestBtnPayText}>
                              Pay
                            </Text>
                          </TouchableOpacity>
                          <TouchableOpacity
                            style={[
                              styles.driverSalaryRequestBtn,
                              styles.driverSalaryRequestBtnReject,
                            ]}
                            onPress={() => {
                              Alert.alert(
                                "Reject request?",
                                `Reject ${driverName}'s request for ₹${Number(req.amount).toLocaleString("en-IN")}?`,
                                [
                                  { text: "Cancel", style: "cancel" },
                                  {
                                    text: "Reject",
                                    style: "destructive",
                                    onPress: async () => {
                                      const { error } =
                                        await updateSalaryRequestStatus(
                                          req.id,
                                          "rejected",
                                        );
                                      if (error) {
                                        Alert.alert(
                                          "Reject failed",
                                          error.message,
                                        );
                                        return;
                                      }
                                      setPendingDriverSalaryRequests((prev) =>
                                        prev.filter((r) => r.id !== req.id),
                                      );
                                    },
                                  },
                                ],
                              );
                            }}
                            accessibilityLabel="Reject this request"
                          >
                            <Text
                              style={styles.driverSalaryRequestBtnRejectText}
                            >
                              Reject
                            </Text>
                          </TouchableOpacity>
                        </View>
                      </View>
                    );
                  })}
                </View>
              )}
              <DriversTab
                organizationId={orgId}
                drivers={driverRows}
                trips={tripRows}
                transactions={ledgerTransactions ?? undefined}
                driverOffers={
                  Object.keys(driverOffers).length > 0
                    ? driverOffers
                    : undefined
                }
                parentLoading={entitiesLoading}
                onTotals={setTabTotals}
                onRowSelect={handleEntityRowSelect}
                searchQuery={searchQuery}
                entityFilter={entityFilter}
                tripPartyMap={tripPartyMap}
              />
            </>
          )}
        </View>
      </ScrollView>

      {/* Floating action buttons: hide while scrolling, show when scroll stops */}
      <View
        style={[styles.fabContainer, { paddingBottom: insets.bottom + 24 }]}
        pointerEvents={fabVisible ? "box-none" : "none"}
      >
        <Animated.View
          style={[styles.fabAnimatedWrap, fabContainerAnimatedStyle]}
        >
          {financeSubTab === "ledger" ? null : (
            <FabButton
              icon="user-plus"
              iconSize={18}
              style={styles.fab}
              innerRingStyle={styles.fabInnerRing}
              accentColor={Theme.textOnDark}
              onPress={() => {
                if (financeSubTab === "customers") setShowAddClientModal(true);
                else if (financeSubTab === "suppliers")
                  setShowAddSupplierModal(true);
                else if (financeSubTab === "garage")
                  setShowAddVehicleModal(true);
                else if (financeSubTab === "drivers")
                  setShowAddDriverModal(true);
              }}
              accessibilityLabel="Add node"
              testID="add-driver-fab"
            />
          )}
        </Animated.View>
      </View>

      <AddTransactionModal
        visible={showTransactionModal}
        onClose={() => {
          setShowTransactionModal(false);
          setEditingEntry(null);
          setAddEntryContext(null);
          setDefaultDriverPaymentTypeForModal(null);
          setPayDriverRequestTripPrefill(null);
        }}
        onSubmit={handleTransactionSubmit}
        clients={clients}
        suppliers={supplierPartyOptions}
        supplierLinkedOrgIds={supplierLinkedOrgIds}
        drivers={driverPartyOptions}
        vehicles={vehicleOptions}
        trips={modalTripOptions}
        defaultPartyId={defaultPartyId}
        defaultPartyName={
          selectedEntity?.entityType === "CLIENT" ||
          selectedEntity?.entityType === "SUPPLIER"
            ? (selectedEntity.data.name ?? null)
            : undefined
        }
        lockedPartyId={
          selectedEntity?.entityType === "DRIVER" && addEntryContext == null
            ? selectedEntity.data.id
            : undefined
        }
        lockedPartyName={
          selectedEntity?.entityType === "DRIVER" && addEntryContext == null
            ? (selectedEntity.data.name ?? undefined)
            : undefined
        }
        partyContext={
          financeSubTab === "customers"
            ? "customers"
            : financeSubTab === "suppliers"
              ? "suppliers"
              : "all"
        }
        initialEntry={editingEntry}
        lockedAmount={
          selectedEntity?.entityType === "DRIVER" && addEntryContext == null
            ? (selectedEntity.data.pending ?? selectedEntity.data.due ?? 0)
            : undefined
        }
        salaryAmount={
          selectedEntity?.entityType === "DRIVER"
            ? (driverOffers[selectedEntity.data.id]?.payableAmount ?? null)
            : undefined
        }
        defaultTripId={
          payDriverRequestTripPrefill?.defaultTripId ??
          addEntryContext?.tripId ??
          undefined
        }
        tripLocked={payDriverRequestTripPrefill?.tripLocked ?? false}
        defaultType={
          addEntryContext?.intent === "client_receivable" ? "in" : undefined
        }
        defaultContactId={
          addEntryContext
            ? (() => {
                const trip = tripRows.find(
                  (t) => t.id === addEntryContext.tripId,
                );
                if (!trip) return undefined;
                if (addEntryContext.intent === "client_receivable")
                  return trip.client_id ?? undefined;
                if (addEntryContext.intent === "supplier_payable")
                  return trip.supplier_id ?? undefined;
                if (addEntryContext.intent === "driver_payable")
                  return trip.driver_id ?? undefined;
                return undefined;
              })()
            : undefined
        }
        defaultContactType={
          addEntryContext?.intent === "client_receivable"
            ? "client"
            : addEntryContext?.intent === "supplier_payable"
              ? "supplier"
              : addEntryContext?.intent === "driver_payable"
                ? "driver"
                : undefined
        }
        defaultDriverPaymentType={defaultDriverPaymentTypeForModal ?? undefined}
      />

      <AddClientModal
        visible={showAddClientModal}
        onClose={() => setShowAddClientModal(false)}
        onComplete={handleAddClientComplete}
        organizationId={currentOrganization?.id ?? null}
        noOrganizationMessage={currentOrganization ? null : NO_ORG_MESSAGE}
        onRefreshOrganization={refreshOrganization}
        searchInviteeByPhone={searchInviteeByPhone}
        onSendInvitation={handleSendClientInvitation}
      />

      <AddSupplierModal
        visible={showAddSupplierModal}
        onClose={() => setShowAddSupplierModal(false)}
        onComplete={handleAddSupplierComplete}
        noOrganizationMessage={currentOrganization ? null : NO_ORG_MESSAGE}
        onRefreshOrganization={refreshOrganization}
        searchInviteeByPhone={searchInviteeByPhone}
        onSendInvitation={handleSendSupplierInvitation}
      />

      <AddVehicleModal
        visible={showAddVehicleModal}
        onClose={() => setShowAddVehicleModal(false)}
        onComplete={handleAddVehicleComplete}
        ownAssetOnly={true}
      />

      <AddDriverModal
        visible={showAddDriverModal}
        onClose={() => setShowAddDriverModal(false)}
        onComplete={handleAddDriverInviteComplete}
        onAddDriver={handleAddDriverDirect}
        salariedOnly={true}
      />

      {selectedEntity && (
        <EntityDetailOverlay
          entity={selectedEntity.data}
          entityType={selectedEntity.entityType}
          subTab={selectedEntity.subTab}
          trips={selectedEntityTrips}
          transactions={selectedEntityTransactions ?? undefined}
          allLedgerTransactions={ledgerTransactions ?? undefined}
          driverOffer={
            selectedEntity.entityType === "DRIVER"
              ? (driverOffers[selectedEntity.data.id] ?? null)
              : null
          }
          driverLedgerEntries={
            selectedEntity.entityType === "DRIVER"
              ? (selectedDriverLedgerEntries ?? [])
              : undefined
          }
          vehicle={
            selectedEntity.entityType === "VEHICLE"
              ? (vehicleRows.find((v) => v.id === selectedEntity.data.id) ??
                null)
              : undefined
          }
          driverProfile={
            selectedEntity.entityType === "DRIVER"
              ? (driverRows.find((d) => d.id === selectedEntity.data.id) ??
                null)
              : undefined
          }
          driverSalaryRequests={
            selectedEntity.entityType === "DRIVER"
              ? pendingDriverSalaryRequests.filter(
                  (r) => r.driver_id === selectedEntity.data.id,
                )
              : undefined
          }
          onPayDriverRequest={
            selectedEntity.entityType === "DRIVER"
              ? (req) => {
                  salaryRequestIdToPayAfterSubmitRef.current = req.id;
                  const isTripBased =
                    req.request_type === "trip_based" &&
                    Array.isArray(req.trip_ids) &&
                    req.trip_ids.length > 0;
                  setDefaultDriverPaymentTypeForModal(
                    isTripBased ? "settlement" : "advance",
                  );
                  setPayDriverRequestTripPrefill(
                    isTripBased
                      ? {
                          defaultTripId: req.trip_ids[0],
                          tripLocked: true,
                        }
                      : null,
                  );
                  setSelectedEntity((prev) =>
                    prev
                      ? {
                          ...prev,
                          data: {
                            ...prev.data,
                            pending: Number(req.amount),
                            due: Number(req.amount),
                          },
                        }
                      : null,
                  );
                  setShowTransactionModal(true);
                }
              : undefined
          }
          onRejectDriverRequest={
            selectedEntity.entityType === "DRIVER"
              ? (requestId) => {
                  updateSalaryRequestStatus(requestId, "rejected").then(
                    ({ error }) => {
                      if (!error)
                        setPendingDriverSalaryRequests((prev) =>
                          prev.filter((r) => r.id !== requestId),
                        );
                    },
                  );
                }
              : undefined
          }
          onBack={() => setSelectedEntity(null)}
          onAddTransaction={(context) => {
            setAddEntryContext(context ?? null);
            const entity = selectedEntity;
            if (entity) {
              const params = new URLSearchParams({
                entityType: entity.entityType,
                entityId: String(entity.data.id),
                partyName: String(entity.data.name ?? ""),
              });
              if (
                entity.entityType === "CLIENT" ||
                entity.entityType === "SUPPLIER"
              ) {
                params.set(
                  "partyContext",
                  entity.entityType === "CLIENT" ? "customers" : "suppliers",
                );
                params.set("partyId", String(entity.data.id));
              }
              if (entity.entityType === "DRIVER")
                params.set("partyId", String(entity.data.id));
              router.push(`/(modals)/ledger-sync?${params.toString()}`);
            } else {
              setShowTransactionModal(true);
            }
          }}
          organizationId={currentOrganization?.id ?? null}
          onRefresh={() => {
            setLedgerRefreshKey((k) => k + 1);
            setEntitiesRefreshKey((k) => k + 1);
          }}
        />
      )}

      <TripPnLDetailSheet
        visible={garageTripIdForPnL != null}
        onClose={() => setGarageTripIdForPnL(null)}
        trip={tripRows.find((t) => t.id === garageTripIdForPnL) ?? null}
        transactions={ledgerTransactions ?? null}
      />

      <LedgerReportModal
        visible={showReportModal}
        onClose={() => setShowReportModal(false)}
        transactions={
          sourceSupplyFilter === "all" ? filteredLedger : filteredLedgerBySource
        }
        title="Ledger report"
      />

      <SharedLedgerModal
        visible={showSharedLedgerModal}
        onClose={() => setShowSharedLedgerModal(false)}
        organizationId={orgId}
        ledgerTransactions={ledgerTransactions ?? []}
        clients={clients.map((c) => ({ id: c.id, name: c.name }))}
        suppliers={suppliersList}
        tripCountByParty={tripCountByParty}
      />

      {/* Entity list: distinct entities in ledger; select one to show only that entity's transactions. */}
      <Modal
        visible={showEntityListModal && financeSubTab === "ledger"}
        transparent
        animationType="fade"
        onRequestClose={() => setShowEntityListModal(false)}
      >
        <TouchableWithoutFeedback onPress={() => setShowEntityListModal(false)}>
          <View
            style={[styles.entityListBackdrop, { paddingTop: insets.top + 80 }]}
          >
            <TouchableWithoutFeedback onPress={() => {}}>
              <View style={styles.entityListPanel}>
                <View style={styles.entityListPanelHeader}>
                  <Text style={styles.entityListPanelTitle}>
                    FILTER BY CATEGORY
                  </Text>
                </View>
                <ScrollView
                  style={styles.entityListCategoriesScroll}
                  contentContainerStyle={styles.entityListCategories}
                  showsVerticalScrollIndicator={true}
                  keyboardShouldPersistTaps="handled"
                >
                  {(
                    [
                      {
                        key: "all" as const,
                        label: "All",
                        icon: "th-large" as const,
                        count: ledgerCategoryCounts.all,
                      },
                      {
                        key: "customers" as const,
                        label: "Customers",
                        icon: "users" as const,
                        count: ledgerCategoryCounts.customers,
                      },
                      {
                        key: "suppliers" as const,
                        label: "Suppliers",
                        icon: "truck" as const,
                        count: ledgerCategoryCounts.suppliers,
                      },
                      {
                        key: "vehicle" as const,
                        label: "Vehicle",
                        icon: "car" as const,
                        count: ledgerCategoryCounts.vehicle,
                      },
                      {
                        key: "driver" as const,
                        label: "Driver",
                        icon: "user" as const,
                        count: ledgerCategoryCounts.driver,
                      },
                    ] as const
                  ).map(({ key, label, icon, count }) => {
                    const isSelected = selectedLedgerCategory === key;
                    return (
                      <TouchableOpacity
                        key={key}
                        style={[
                          styles.entityCategoryCard,
                          isSelected && styles.entityCategoryCardActive,
                        ]}
                        onPress={() => {
                          setSelectedLedgerCategory(key);
                          setShowEntityListModal(false);
                        }}
                        activeOpacity={0.8}
                      >
                        <View
                          style={[
                            styles.entityCategoryIconWrap,
                            isSelected && styles.entityCategoryIconWrapActive,
                          ]}
                        >
                          <FontAwesome
                            name={icon}
                            size={18}
                            color={isSelected ? Theme.textOnDark : Theme.textMuted}
                          />
                        </View>
                        <Text
                          style={[
                            styles.entityCategoryLabel,
                            isSelected && styles.entityCategoryLabelActive,
                          ]}
                          numberOfLines={1}
                        >
                          {label}
                        </Text>
                        <Text
                          style={[
                            styles.entityCategoryCount,
                            isSelected && styles.entityCategoryCountActive,
                          ]}
                        >
                          {count}
                        </Text>
                        {isSelected && (
                          <FontAwesome
                            name="check-circle"
                            size={16}
                            color={Theme.darkGreen}
                            style={styles.entityCategoryCheck}
                          />
                        )}
                      </TouchableOpacity>
                    );
                  })}
                </ScrollView>
              </View>
            </TouchableWithoutFeedback>
            <TouchableWithoutFeedback
              onPress={() => setShowEntityListModal(false)}
            >
              <View style={styles.entityListBackdropTouchable} />
            </TouchableWithoutFeedback>
          </View>
        </TouchableWithoutFeedback>
      </Modal>
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: Theme.screenBackground },
  centered: {
    flex: 1,
    justifyContent: "center",
    alignItems: "center",
    padding: 24,
  },
  message: { fontSize: 16, color: Theme.textSecondary },

  darkBlock: {
    backgroundColor: "#000000",
    width: "100%",
    paddingBottom: 4,
    shadowColor: Theme.shadow,
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.2,
    shadowRadius: 8,
    elevation: 4,
  },
  darkBlockContent: {
    paddingHorizontal: 0,
  },
  fiscalTabScroll: {
    width: "100%",
  },
