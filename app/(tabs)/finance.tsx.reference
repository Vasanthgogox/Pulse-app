    flex: 1,
    minWidth: MIN_FISCAL_TAB_WIDTH,
    position: "relative" as const,
    paddingVertical: 6,
    justifyContent: "center",
    alignItems: "center",
  },
  fiscalTabActive: {},
  fiscalTabText: {
    fontSize: 8,
    fontWeight: "800",
    textTransform: "uppercase",
    letterSpacing: 2,
    color: Theme.textSecondary,
  },
  fiscalTabTextActive: {
    color: Theme.textOnDark,
  },
  fiscalTabUnderline: {
    position: "absolute",
    bottom: 0,
    left: 0,
    right: 0,
    height: 1.5,
    backgroundColor: Theme.teslaRed,
  },

  tableScroll: { flex: 1 },
  tableContent: {
    paddingHorizontal: 0,
    paddingTop: 0,
    backgroundColor: Theme.screenBackground,
  },
  tableBodyWrap: {
    paddingHorizontal: 10,
    borderLeftWidth: 1,
    borderRightWidth: 1,
    borderBottomWidth: 1,
    borderLeftColor: Theme.borderLight,
    borderRightColor: Theme.borderLight,
    borderBottomColor: Theme.borderLight,
    borderBottomLeftRadius: 12,
    borderBottomRightRadius: 12,
    backgroundColor: Theme.screenBackground,
    marginTop: -1,
    shadowColor: "#000",
    shadowOffset: { width: 0, height: 1 },
    shadowOpacity: 0.02,
    shadowRadius: 2,
    elevation: 1,
  },
  driverSalaryRequestsBlock: {
    paddingVertical: 16,
    paddingHorizontal: 4,
    borderBottomWidth: 1,
    borderBottomColor: Theme.borderLight,
  },
  driverSalaryRequestsTitle: {
    fontSize: 12,
    fontWeight: "800",
    letterSpacing: 0.5,
    textTransform: "uppercase",
    color: Theme.textMuted,
    marginBottom: 4,
  },
  driverSalaryRequestsSubtitle: {
    fontSize: 11,
    fontWeight: "600",
    color: Theme.textMuted,
    marginBottom: 12,
  },
  driverSalaryRequestCard: {
    flexDirection: "row",
    alignItems: "flex-start",
    justifyContent: "space-between",
    gap: 12,
    paddingVertical: 12,
    paddingHorizontal: 12,
    marginBottom: 8,
    backgroundColor: Theme.surface,
    borderWidth: 1,
    borderColor: Theme.borderLight,
    borderRadius: 12,
  },
  driverSalaryRequestCardMain: { flex: 1, minWidth: 0 },
  driverSalaryRequestDriverName: {
    fontSize: 15,
    fontWeight: "800",
    color: Theme.textPrimary,
    marginBottom: 2,
  },
  driverSalaryRequestMeta: {
    fontSize: 12,
    fontWeight: "600",
    color: Theme.textMuted,
    marginBottom: 4,
  },
  driverSalaryRequestNote: {
    fontSize: 11,
    fontWeight: "500",
    color: Theme.textSecondary,
    marginBottom: 6,
    fontStyle: "italic",
  },
  driverSalaryRequestAmountRow: { marginTop: 4 },
  driverSalaryRequestAmount: {
    fontSize: 18,
    fontWeight: "800",
    color: Theme.positive,
  },
  driverSalaryRequestActions: {
    flexDirection: "row",
    alignItems: "center",
    gap: 8,
  },
  driverSalaryRequestBtn: {
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "center",
    gap: 6,
    paddingVertical: 10,
    paddingHorizontal: 14,
    borderRadius: 10,
    minWidth: 72,
  },
  driverSalaryRequestBtnPay: {
    backgroundColor: Theme.positive,
  },
  driverSalaryRequestBtnPayText: {
    fontSize: 12,
    fontWeight: "800",
    color: Theme.textOnPrimary,
  },
  driverSalaryRequestBtnReject: {
    backgroundColor: Theme.surface,
    borderWidth: 1,
    borderColor: Theme.borderInput,
  },
  driverSalaryRequestBtnRejectText: {
    fontSize: 12,
    fontWeight: "800",
    color: Theme.textSecondary,
  },
  /* Tesla-style header-like filter & info strips: dark bg, tight uppercase typography */
  ledgerEntityFilterBanner: {
    flexDirection: "row",
    alignItems: "stretch",
    marginHorizontal: 0,
    marginTop: 0,
    marginBottom: 0,
    backgroundColor: Theme.darkBackground,
    borderBottomWidth: 1,
    borderBottomColor: Theme.separatorDark,
    overflow: "hidden",
  },
  ledgerEntityFilterBannerAccent: {
    width: 3,
    backgroundColor: Theme.teslaRed,
    minHeight: 1,
  },
  ledgerEntityFilterBannerContent: {
    flex: 1,
    marginRight: 8,
    minWidth: 0,
    paddingVertical: 10,
    paddingLeft: 14,
    paddingRight: 8,
  },
  ledgerEntityFilterLabelRow: {
    flexDirection: "row",
    alignItems: "center",
    flexWrap: "wrap",
    gap: 6,
  },
  ledgerEntityFilterIconWrap: {
    marginRight: 2,
  },
  ledgerEntityFilterLabel: {
    fontSize: 9,
    fontWeight: "600",
    color: Theme.textSecondary,
    letterSpacing: 2,
    textTransform: "uppercase",
  },
  ledgerEntityFilterBadge: {
    backgroundColor: Theme.darkBackground,
    paddingVertical: 3,
    paddingHorizontal: 10,
    borderRadius: 4,
    maxWidth: "100%",
  },
  ledgerEntityFilterText: {
    fontSize: 12,
    fontWeight: "700",
    color: Theme.textOnDark,
    letterSpacing: 0.8,
    textTransform: "uppercase",
  },
  ledgerEntityFilterStatsRow: {
    flexDirection: "row",
    alignItems: "center",
    gap: 14,
    marginTop: 6,
  },
  ledgerEntityFilterStat: {
    flexDirection: "row",
    alignItems: "center",
    gap: 4,
  },
  ledgerEntityFilterStatValue: {
    fontSize: 12,
    fontWeight: "700",
    color: Theme.textOnDark,
    letterSpacing: 0.5,
  },
  ledgerEntityFilterStatUnit: {
    fontSize: 9,
    fontWeight: "600",
    color: Theme.textSecondary,
    letterSpacing: 1.2,
    textTransform: "uppercase",
  },
  ledgerEntityFilterStatIn: { gap: 4 },
  ledgerEntityFilterStatOut: { gap: 4 },
  ledgerEntityFilterStatPressed: {
    opacity: 0.75,
  },
  ledgerEntityFilterRatioBarWrap: {
    flexDirection: "row",
    height: 3,
    borderRadius: 2,
