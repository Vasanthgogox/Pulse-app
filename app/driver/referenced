              <p className="text-[10px] text-zinc-500 uppercase leading-relaxed mb-8">Establish secure neural link to begin regional mission scanning</p>
              <button 
                onClick={() => setIsOnline(true)}
                className="w-full py-5 bg-[#10B981] text-white font-black text-[12px] tracking-[0.5em] shadow-[0_15px_35px_rgba(16,185,129,0.3)] active:scale-95 transition-all rounded-sm"
              >
                GO ONLINE
              </button>
            </div>
          </div>
        ) : activeMission ? (
          <div className="text-center space-y-6 animate-in zoom-in">
            <div className="relative inline-block">
              <Activity className="text-[#10B981] animate-pulse" size={64} />
              <Sparkles className="absolute -top-2 -right-2 text-[#F59E0B] animate-bounce" size={20} />
