      </div>

      <GlobalHeader title="Qu Neural Hub" subtitle={isOnline ? 'Scanning Region' : 'Link Offline'} />

      <div className="relative z-10 p-6 flex-1 flex flex-col items-center justify-center">
        {!isOnline ? (
          <div className="text-center space-y-8 animate-in fade-in duration-1000 w-full px-6">
