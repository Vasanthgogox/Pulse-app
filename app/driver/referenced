                <span className="bg-[#F59E0B] text-black text-[8px] font-black px-3 py-1 tracking-[0.2em] rounded-sm uppercase">Priority found</span>
                <div className="text-right">
                  <p className="text-[7px] font-black text-zinc-500 uppercase mb-1">Commission Yield</p>
                  <p className="text-[20px] font-black text-[#10B981]">₹{(incomingMission.revenue * 0.1).toLocaleString()}</p>
                </div>
              </div>
              <div className="space-y-4 mb-10 border-l border-white/10 pl-5">
                <div>
                  <p className="text-[6px] font-black text-zinc-500 uppercase tracking-widest mb-1">ORIGIN</p>
                  <p className="text-[16px] font-black uppercase leading-none">{incomingMission.origin}</p>
                </div>
                <div>
