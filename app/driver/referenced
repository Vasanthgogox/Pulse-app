  { id: 2, type: 'DR', desc: 'Wallet Withdrawal', amount: 2000, date: '20 Feb' },
  { id: 3, type: 'CR', desc: 'Weekly Base Pay', amount: 3750, date: '18 Feb' },
];

export default function App() {
  const [activeTab, setActiveTab] = useState('radar');
  const [isOnline, setIsOnline] = useState(false);
  const [showSuccess, setShowSuccess] = useState(false);
  const [incomingMission, setIncomingMission] = useState(null);
  const [showProfile, setShowProfile] = useState(false);
  
  // States for Detail Views
  const [activeMission, setActiveMission] = useState(null);
  const [missionStep, setMissionStep] = useState('accepted'); 
  const [selectedHistoryItem, setSelectedHistoryItem] = useState(null);

  // Long Press State
  const [holdProgress, setHoldProgress] = useState(0);
  const [isHolding, setIsHolding] = useState(false);
  const holdTimerRef = useRef(null);

  const triggerSuccess = () => {
    setShowSuccess(true);
    setTimeout(() => setShowSuccess(false), 1500);
  };

  const handleAcceptMission = (mission) => {
    setActiveMission(mission);
    setMissionStep('accepted');
    setActiveTab('control');
    triggerSuccess();
  };

  const getEarning = (trip) => {
    if (trip.type === 'FIXED') return "FIXED SALARY";
    const commission = trip.revenue * DRIVER_PROFILE.commissionRate;
    return `₹${commission.toLocaleString()}`;
  };

  const startHold = () => {
    setIsHolding(true);
    const duration = 1200; 
    const startTime = Date.now();
    holdTimerRef.current = setInterval(() => {
      const elapsed = Date.now() - startTime;
      const progress = Math.min((elapsed / duration) * 100, 100);
      setHoldProgress(progress);
      if (progress >= 100) {
        clearInterval(holdTimerRef.current);
        setMissionStep('completed');
        triggerSuccess();
        setHoldProgress(0);
        setIsHolding(false);
      }
    }, 20);
  };

  const cancelHold = () => {
    if (holdTimerRef.current) clearInterval(holdTimerRef.current);
    setHoldProgress(0);
    setIsHolding(false);
  };

  useEffect(() => {
    if (isOnline && !activeMission) {
      const timer = setTimeout(() => {
        setIncomingMission({
          id: 'QU-8842',
          origin: 'MUMBAI SEZ',
          dest: 'BANGALORE HUB',
          revenue: 52000,
          client: 'TATA MOTORS',
          type: 'COMMISSION',
          cargo: 'Automotive Parts // 12MT',
          distance: '984 KM'
        });
      }, 3000);
      return () => clearTimeout(timer);
    }
  }, [isOnline, activeMission]);

  // --- REUSABLE COMPONENTS ---

  const GlobalHeader = ({ title, subtitle }) => (
    <header className="p-4 pt-6 border-b border-white/5 bg-zinc-950/60 backdrop-blur-xl flex justify-between items-center shrink-0 z-50">
      <div className="flex items-center gap-3">
        <button 
          onClick={() => setShowProfile(true)}
          className="relative active:scale-95 transition-transform"
        >
          <div className="absolute -inset-1 bg-[#10B981] rounded-full blur-[3px] opacity-40"></div>
          <div className="w-10 h-10 rounded-full border-2 border-[#10B981]/30 p-0.5 relative bg-zinc-900 overflow-hidden shadow-lg">
            <img 
              src={`https://api.dicebear.com/7.x/avataaars/svg?seed=Rajesh`} 
              alt="Pilot" 
              className="w-full h-full object-cover rounded-full" 
            />
          </div>
        </button>
        <div>
          <h1 className="text-[9px] font-black tracking-[0.3em] text-[#10B981] uppercase leading-none mb-1">{title}</h1>
          <p className="text-[13px] font-black uppercase tracking-tight text-white leading-none">{subtitle}</p>
        </div>
      </div>
      <div className="flex items-center gap-4">
        <div className="relative">
          <Bell size={18} className="text-zinc-500" />
          <div className="absolute top-0 right-0 w-1.5 h-1.5 bg-[#F59E0B] rounded-full"></div>
        </div>
        <div className="p-1.5 bg-white/5 rounded-sm border border-white/5">
          <MoreVertical size={16} className="text-zinc-500" />
        </div>
      </div>
    </header>
  );

  // --- SUB-VIEWS ---

  const RadarView = () => (
    <div className="flex-1 flex flex-col bg-[#021d17] text-white overflow-hidden relative">
