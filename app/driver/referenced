                <div className="h-2 bg-zinc-800 w-full rounded-full overflow-hidden p-0.5 border border-white/5 shadow-inner">
                  <div className="h-full bg-gradient-to-r from-[#10B981] to-[#34D399] w-[62%] rounded-full shadow-[0_0_15px_rgba(16,185,129,0.4)]"></div>
                </div>
              </div>
            )}
          </div>

          <div className="grid grid-cols-2 gap-3">
             <div className="bg-zinc-900/20 border border-white/5 p-4 rounded-sm flex items-center gap-3">
                <Fuel size={18} className="text-[#10B981]" />
                <div><p className="text-[6px] font-black text-zinc-500 uppercase">Hardware</p><p className="text-[10px] font-black">94% Optimal</p></div>
             </div>
             <div className="bg-zinc-900/20 border border-white/5 p-4 rounded-sm flex items-center gap-3">
                <ShieldCheck size={18} className="text-[#10B981]" />
                <div><p className="text-[6px] font-black text-zinc-500 uppercase">Integrity</p><p className="text-[10px] font-black">Secure</p></div>
             </div>
          </div>
          
          <div className="py-2 space-y-4">
            {missionStep === 'accepted' && (
              <button 
                onClick={() => { setMissionStep('pickup'); triggerSuccess(); }} 
                className="w-full py-5 bg-[#10B981] text-white font-black text-[12px] tracking-[0.4em] flex items-center justify-center gap-3 active:scale-95 shadow-[0_15px_35px_rgba(16,185,129,0.3)] transition-all"
              >
                <MapPin size={18} /> CONFIRM ARRIVAL
              </button>
            )}
            
            {missionStep === 'pickup' && (
              <div className="space-y-4 animate-in slide-in-from-bottom">
                <div className="bg-zinc-900/80 border-2 border-dashed border-[#10B981]/20 p-12 flex flex-col items-center justify-center gap-4 hover:bg-zinc-900 transition-all cursor-pointer rounded-lg group">
