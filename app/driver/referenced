                  {missionStep === 'accepted' && `Voyaging to Origin`}
                  {missionStep === 'pickup' && `Dock Authorization`}
                  {missionStep === 'transit' && `En-Route to Dest`}
                  {missionStep === 'completed' && `Debrief Success`}
                </h3>
              </div>
              <div className="text-right">
                 <p className="text-[7px] font-black text-zinc-500 uppercase mb-1">Aero-ETA</p>
