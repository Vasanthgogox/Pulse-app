                    <CheckCircle2 size={18} className={holdProgress > 0 ? 'animate-pulse' : ''} />
                    <span>{isHolding ? 'SETTLING...' : 'HOLD EXIT'}</span>
                  </div>
                </div>
              </div>
            )}

            {missionStep === 'completed' && (
              <div className="space-y-6 text-center animate-in zoom-in pb-10">
                <div className="p-12 bg-emerald-500/5 border border-emerald-500/20 rounded-xl relative overflow-hidden">
