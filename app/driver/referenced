  { id: 'MSN-771', client: 'RELIANCE', origin: 'SURAT', dest: 'MUMBAI', date: '15 FEB', revenue: 32000, type: 'FIXED', status: 'Completed', cargo: 'Textiles', distance: '280 km' },
];

