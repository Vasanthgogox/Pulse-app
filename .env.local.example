# Copy to .env.local and fill in. Used for local Supabase from device/emulator.
# If you get "Network request failed" on sign-in: either remove .env.local to use
# hosted Supabase from .env, or set the URL reachable from your runtime:
# - Android emulator: EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
# - iOS sim / physical device: EXPO_PUBLIC_SUPABASE_URL=http://YOUR_MAC_IP:54321 (ipconfig getifaddr en0)
# Get anon key: npx supabase status (local Supabase). Use placeholders only—never commit real keys.
EXPO_PUBLIC_SUPABASE_URL=http://YOUR_MAC_IP:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-status
